<script type="module">
  import { exigirSessao, exigirPerfil, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { abrirModal, mostrarAlerta, confirmarAcao } from '../assets/js/modal.js';
  import { calcularFechamentoMensal, obterFechamentoDoMes } from '../assets/js/calculo.js';
  import { registrarLog } from '../assets/js/log.js';

  initSidebarMobile();

  const { usuario, nome, perfil } = await exigirSessao();
  exigirPerfil(perfil, ['gestor', 'administrador']);

  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  const fmtMoeda = (v) => (v ?? 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const fmtPercentual = (v) => v == null ? null : `${(v * 100).toFixed(2).replace(/\.?0+$/, '')}%`;
  const mesAtual = () => new Date().toISOString().slice(0, 7);
  const mesParaReferencia = (mesInput) => `${mesInput}-01`;

  function renderizarValores({ entradaTR, despesas, lucroBruto, distribuicao, lucroLiquido }) {
    document.getElementById('val-entrada').textContent = fmtMoeda(entradaTR);
    document.getElementById('val-despesas').textContent = fmtMoeda(despesas);
    document.getElementById('val-lucro-bruto').textContent = fmtMoeda(lucroBruto);
    document.getElementById('val-lucro-liquido').textContent = fmtMoeda(lucroLiquido);

    const tbody = document.getElementById('tbody-distribuicao');
    tbody.innerHTML = '';
    document.getElementById('distribuicao-vazio').classList.toggle('hidden', (distribuicao || []).length > 0);
    (distribuicao || []).forEach((p) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="py-2">${p.nome}</td>
        <td class="py-2 text-right font-medium">${fmtMoeda(p.valor)}</td>
        <td class="py-2 text-slate-500">${p.deduzDoLucro ? 'Sim' : 'Não'}</td>`;
      tbody.appendChild(tr);
    });
  }

  async function carregarMes() {
    const mes = document.getElementById('fch-mes').value;
    if (!mes) return;
    const mesReferencia = mesParaReferencia(mes);

    const fechamento = await obterFechamentoDoMes(mesReferencia);
    const statusEl = document.getElementById('status-mes');
    const btnFechar = document.getElementById('btn-fechar');
    const btnReabrir = document.getElementById('btn-reabrir');

    if (fechamento && fechamento.bloqueado) {
      statusEl.innerHTML = `<span class="text-xs text-green-700 bg-green-50 rounded px-2 py-1">
        Fechado em ${new Date(fechamento.fechado_em).toLocaleDateString('pt-BR')} — valores congelados nesta data.
      </span>`;
      renderizarValores({
        entradaTR: fechamento.entrada_tr,
        despesas: fechamento.despesas,
        lucroBruto: fechamento.entrada_tr - fechamento.despesas,
        distribuicao: fechamento.distribuicao_lucro,
        lucroLiquido: fechamento.lucro_liquido,
      });
      btnFechar.classList.add('hidden');
      btnReabrir.classList.remove('hidden');
    } else {
      statusEl.innerHTML = `<span class="text-xs text-amber-700 bg-amber-50 rounded px-2 py-1">
        Mês aberto — valores calculados ao vivo a partir dos lançamentos atuais.
      </span>`;
      const calculo = await calcularFechamentoMensal(mesReferencia);
      renderizarValores(calculo);
      btnFechar.classList.remove('hidden');
      btnReabrir.classList.add('hidden');
    }
  }

  document.getElementById('fch-mes').addEventListener('change', carregarMes);

  document.getElementById('btn-fechar').addEventListener('click', async () => {
    const mes = document.getElementById('fch-mes').value;
    const mesReferencia = mesParaReferencia(mes);

    const ok = await confirmarAcao(
      'Fechar este mês congela os valores de Entrada TR, Despesas e distribuição de lucro. Se algo for lançado depois com data retroativa, o sistema vai avisar e perguntar antes de alterar esse fechamento.',
      { titulo: 'Fechar mês', textoConfirmar: 'Fechar mês' }
    );
    if (!ok) return;

    const calculo = await calcularFechamentoMensal(mesReferencia);
    const existente = await obterFechamentoDoMes(mesReferencia);

    const payload = {
      mes_referencia: mesReferencia,
      entrada_tr: calculo.entradaTR,
      despesas: calculo.despesas,
      distribuicao_lucro: calculo.distribuicao,
      lucro_liquido: calculo.lucroLiquido,
      bloqueado: true,
      fechado_por: usuario.id,
      fechado_em: new Date().toISOString(),
    };

    const { error } = existente
      ? await supabase.from('fechamentos_mensais').update(payload).eq('id', existente.id)
      : await supabase.from('fechamentos_mensais').insert(payload);

    if (error) { await mostrarAlerta('Erro ao fechar o mês: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({
      acao: existente ? 'editar' : 'criar', tabela: 'fechamentos_mensais', registroId: existente?.id,
      descricao: `Mês ${mes} fechado — lucro líquido ${calculo.lucroLiquido.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}`,
    });
    await mostrarAlerta('Mês fechado com sucesso.', { titulo: 'Pronto' });
    carregarMes();
  });

  document.getElementById('btn-reabrir').addEventListener('click', async () => {
    const mes = document.getElementById('fch-mes').value;
    const mesReferencia = mesParaReferencia(mes);

    const ok = await confirmarAcao(
      'Reabrir o mês volta o cálculo para o modo "ao vivo" (recalcula sozinho a cada lançamento), até você fechá-lo de novo.',
      { titulo: 'Reabrir mês', textoConfirmar: 'Reabrir' }
    );
    if (!ok) return;

    const existente = await obterFechamentoDoMes(mesReferencia);
    if (existente) {
      const { error } = await supabase.from('fechamentos_mensais').update({ bloqueado: false }).eq('id', existente.id);
      if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
      await registrarLog({ acao: 'editar', tabela: 'fechamentos_mensais', registroId: existente.id, descricao: `Mês ${mes} reaberto` });
    }
    carregarMes();
  });

  document.getElementById('fch-mes').value = mesAtual();
  carregarMes();
</script>
</body>
</html>
