      </nav>

      <div class="px-4 py-4 border-t border-white/10">
        <p id="usuario-nome" class="text-xs text-white/70 mb-2">—</p>
        <button id="btn-sair" class="text-xs text-white/70 hover:text-white underline">Sair</button>
      </div>
    </aside>

    <!-- Conteúdo -->
    <main class="flex-1 p-4 sm:p-6 min-w-0">
     <div class="max-w-4xl mx-auto">
      <h1 class="text-xl font-bold text-slate-900 mb-1">Parâmetros</h1>
      <p class="text-sm text-slate-500 mb-6">
        Regras padrão de cálculo. Uma exceção por imóvel (quando cadastrada na tela do imóvel) sempre
        tem prioridade sobre a regra geral daqui.
      </p>

      <!-- ===================== REGRAS GERAIS ===================== -->
      <section class="tr-card mb-8">
        <div class="px-5 py-4 border-b border-slate-200">
          <h2 class="font-semibold text-slate-900">Regras gerais</h2>
          <p class="text-xs text-slate-500">Comissão, limpeza e nota fiscal.</p>
        </div>

        <form id="form-regra" class="px-5 py-4 grid grid-cols-2 sm:grid-cols-6 gap-3 border-b border-slate-200 bg-slate-50">
          <select id="r-tipo" required class="tr-input col-span-2 sm:col-span-1 rounded-lg border border-slate-300 px-2 py-2 text-sm">
            <option value="comissao">Comissão</option>
            <option value="limpeza">Limpeza (valor à faxineira)</option>
            <option value="nf">Nota Fiscal</option>
          </select>
          <input id="r-percentual" type="number" step="0.01" min="0" max="100" placeholder="% (ex.: 20)"
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <input id="r-valor" type="number" step="0.01" min="0" placeholder="Valor fixo (R$)"
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <select id="r-base" class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
            <option value="bruto_menos_limpeza">Base: bruto − limpeza</option>
            <option value="bruto">Base: bruto</option>
          </select>
          <input id="r-inicio" type="date" required
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <button type="submit" class="tr-btn rounded-lg px-3 py-2 text-sm font-semibold">Adicionar</button>
        </form>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-slate-500 border-b border-slate-200">
                <th class="px-5 py-2 font-medium">Tipo</th>
                <th class="px-5 py-2 font-medium">Valor</th>
                <th class="px-5 py-2 font-medium">Base</th>
                <th class="px-5 py-2 font-medium">Vigência</th>
                <th class="px-5 py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="tbody-regras"></tbody>
          </table>
          <p id="regras-vazio" class="hidden px-5 py-6 text-sm text-slate-400">Nenhuma regra cadastrada ainda.</p>
        </div>
      </section>

      <!-- ================= DISTRIBUIÇÃO DE LUCRO ================= -->
      <section class="tr-card mb-8">
        <div class="px-5 py-4 border-b border-slate-200">
          <h2 class="font-semibold text-slate-900">Distribuição de lucro</h2>
          <p class="text-xs text-slate-500">Participantes do fechamento mensal (ex.: sócios).</p>
        </div>

        <form id="form-participante" class="px-5 py-4 grid grid-cols-2 sm:grid-cols-6 gap-3 border-b border-slate-200 bg-slate-50">
          <input id="p-nome" type="text" required placeholder="Nome"
            class="tr-input col-span-2 rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <input id="p-percentual" type="number" step="0.01" min="0" max="100" placeholder="% do lucro"
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <input id="p-fixo" type="number" step="0.01" min="0" placeholder="Valor fixo (R$)"
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <input id="p-minimo" type="number" step="0.01" min="0" placeholder="Mínimo garantido (R$)"
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <label class="flex items-center gap-2 text-xs text-slate-600">
            <input id="p-deduz" type="checkbox" class="rounded border-slate-300">
            Deduz do lucro
          </label>
          <button type="submit" class="tr-btn col-span-2 sm:col-span-1 rounded-lg px-3 py-2 text-sm font-semibold">Adicionar</button>
        </form>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-slate-500 border-b border-slate-200">
                <th class="px-5 py-2 font-medium">Nome</th>
                <th class="px-5 py-2 font-medium">Regra</th>
                <th class="px-5 py-2 font-medium">Deduz do lucro?</th>
                <th class="px-5 py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="tbody-participantes"></tbody>
          </table>
          <p id="participantes-vazio" class="hidden px-5 py-6 text-sm text-slate-400">Nenhum participante cadastrado ainda.</p>
        </div>
      </section>
     </div>
    </main>
  </div>

<script type="module">
  import { exigirSessao, exigirPerfil, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { mostrarAlerta, confirmarAcao } from '../assets/js/modal.js';
  import { registrarLog } from '../assets/js/log.js';
  import { btnExcluir } from '../assets/js/icones.js';

  initSidebarMobile();

  const { nome, perfil } = await exigirSessao();
  exigirPerfil(perfil, ['gestor']); // dupla garantia — o RLS já bloqueia no banco

  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  const hoje = () => new Date().toISOString().slice(0, 10);
  const fmtMoeda = (v) => v == null ? '—' : v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const fmtPercentual = (v) => v == null ? null : `${(v * 100).toFixed(2).replace(/\.?0+$/, '')}%`;
  const rotuloTipo = { comissao: 'Comissão', limpeza: 'Limpeza', nf: 'Nota Fiscal' };

  // ----------------------- Regras gerais -----------------------
  async function carregarRegras() {
    const { data, error } = await supabase
      .from('parametros_gerais')
      .select('*')
      .order('tipo')
      .order('vigencia_inicio', { ascending: false });

    if (error) { await mostrarAlerta('Erro ao carregar regras: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-regras');
    tbody.innerHTML = '';
    document.getElementById('regras-vazio').classList.toggle('hidden', data.length > 0);

    data.forEach((r) => {
      const valorTexto = r.percentual != null ? fmtPercentual(r.percentual) : fmtMoeda(r.valor);
      const vigenciaTexto = `${r.vigencia_inicio} ${r.vigencia_fim ? '→ ' + r.vigencia_fim : '(em vigor)'}`;
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5">${rotuloTipo[r.tipo] || r.tipo}</td>
        <td class="px-5 py-2.5">${valorTexto}</td>
        <td class="px-5 py-2.5 text-slate-500">${r.base_calculo === 'bruto' ? 'bruto' : 'bruto − limpeza'}</td>
        <td class="px-5 py-2.5 text-slate-500">${vigenciaTexto}</td>
        <td class="px-5 py-2.5 text-right">
          <div class="inline-flex items-center gap-1">
            ${r.vigencia_fim ? '' : `<button data-id="${r.id}" class="btn-encerrar text-xs text-amber-600 hover:underline mr-2">Encerrar</button>`}
            ${btnExcluir(r.id, 'btn-excluir-regra')}
          </div>
        </td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-encerrar').forEach((b) => b.addEventListener('click', () => encerrarRegra(b.dataset.id)));
    tbody.querySelectorAll('.btn-excluir-regra').forEach((b) => b.addEventListener('click', () => excluirRegra(b.dataset.id)));
  }

  document.getElementById('form-regra').addEventListener('submit', async (e) => {
    e.preventDefault();
    const percentualInput = document.getElementById('r-percentual').value;
    const valorInput = document.getElementById('r-valor').value;

    if (!percentualInput && !valorInput) {
      await mostrarAlerta('Informe um percentual ou um valor fixo.');
      return;
    }

    const tipoRegra = document.getElementById('r-tipo').value;
    const { data: salvo, error } = await supabase.from('parametros_gerais').insert({
      tipo: tipoRegra,
      percentual: percentualInput ? Number(percentualInput) / 100 : null,
      valor: valorInput ? Number(valorInput) : null,
      base_calculo: document.getElementById('r-base').value,
      vigencia_inicio: document.getElementById('r-inicio').value || hoje(),
    }).select().single();

    if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'criar', tabela: 'parametros_gerais', registroId: salvo.id, descricao: `Regra geral de ${rotuloTipo[tipoRegra] || tipoRegra} cadastrada` });
    e.target.reset();
    carregarRegras();
  });

  async function encerrarRegra(id) {
    if (!(await confirmarAcao('Encerrar a vigência desta regra hoje?'))) return;
    const { error } = await supabase.from('parametros_gerais').update({ vigencia_fim: hoje() }).eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'editar', tabela: 'parametros_gerais', registroId: id, descricao: 'Vigência de regra geral encerrada' });
    carregarRegras();
  }

  async function excluirRegra(id) {
    if (!(await confirmarAcao('Excluir esta regra definitivamente? Reservas já salvas mantêm seu próprio snapshot e não são afetadas.'))) return;
    const { error } = await supabase.from('parametros_gerais').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'parametros_gerais', registroId: id, descricao: 'Regra geral excluída' });
    carregarRegras();
  }

  // ----------------------- Distribuição de lucro -----------------------
  async function carregarParticipantes() {
    const { data, error } = await supabase
      .from('participantes_lucro')
      .select('*')
      .is('vigencia_fim', null)
      .order('nome');

    if (error) { await mostrarAlerta('Erro ao carregar participantes: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-participantes');
    tbody.innerHTML = '';
    document.getElementById('participantes-vazio').classList.toggle('hidden', data.length > 0);

    data.forEach((p) => {
      const regraTexto = p.valor_fixo != null
        ? fmtMoeda(p.valor_fixo) + ' fixo'
        : `${fmtPercentual(p.percentual)}${p.valor_minimo != null ? ' (mín. ' + fmtMoeda(p.valor_minimo) + ')' : ''}`;
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5">${p.nome}</td>
        <td class="px-5 py-2.5">${regraTexto}</td>
        <td class="px-5 py-2.5">${p.deduz_do_lucro ? 'Sim' : 'Não'}</td>
        <td class="px-5 py-2.5 text-right">${btnExcluir(p.id, 'btn-excluir-part')}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-excluir-part').forEach((b) => b.addEventListener('click', () => removerParticipante(b.dataset.id)));
  }

  document.getElementById('form-participante').addEventListener('submit', async (e) => {
    e.preventDefault();
    const percentualInput = document.getElementById('p-percentual').value;
    const fixoInput = document.getElementById('p-fixo').value;

    if (!percentualInput && !fixoInput) {
      await mostrarAlerta('Informe um percentual do lucro ou um valor fixo.');
      return;
    }

    const nomeParticipante = document.getElementById('p-nome').value;
    const { data: salvo, error } = await supabase.from('participantes_lucro').insert({
      nome: nomeParticipante,
      percentual: percentualInput ? Number(percentualInput) / 100 : null,
      valor_fixo: fixoInput ? Number(fixoInput) : null,
      valor_minimo: document.getElementById('p-minimo').value ? Number(document.getElementById('p-minimo').value) : null,
      deduz_do_lucro: document.getElementById('p-deduz').checked,
    }).select().single();

    if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'criar', tabela: 'participantes_lucro', registroId: salvo.id, descricao: `Participante "${nomeParticipante}" adicionado à distribuição de lucro` });
    e.target.reset();
    carregarParticipantes();
  });

  async function removerParticipante(id) {
    if (!(await confirmarAcao('Encerrar a participação desta pessoa na distribuição de lucro?'))) return;
    const { error } = await supabase.from('participantes_lucro').update({ vigencia_fim: hoje() }).eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'editar', tabela: 'participantes_lucro', registroId: id, descricao: 'Participação encerrada na distribuição de lucro' });
    carregarParticipantes();
  }

  carregarRegras();
  carregarParticipantes();
</script>
</body>
</html>
