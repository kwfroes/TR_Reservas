<script type="module">
  import { exigirSessao, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { abrirModal, fecharModal, mostrarAlerta, confirmarAcao } from '../assets/js/modal.js';
  import { registrarLog } from '../assets/js/log.js';
  import { celulaAcoes, btnVisualizar, btnEditar, btnExcluir } from '../assets/js/icones.js';

  initSidebarMobile();

  const { nome, perfil } = await exigirSessao();
  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  const podeVerAcesso = perfil === 'gestor' || perfil === 'administrador';
  const hoje = () => new Date().toISOString().slice(0, 10);
  const fmtMoeda = (v) => v == null ? '—' : v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const fmtPercentual = (v) => v == null ? null : `${(v * 100).toFixed(2).replace(/\.?0+$/, '')}%`;

  let imovelAtualId = null;
  let listaProprietariosCache = [];

  // ----------------------- Abas -----------------------
  function ativarAba(tabId) {
    document.querySelectorAll('.tr-tab-btn').forEach((b) => b.classList.toggle('ativo', b.dataset.tab === tabId));
    document.querySelectorAll('[data-painel]').forEach((p) => p.classList.toggle('hidden', p.dataset.painel !== tabId));
  }

  function ligarAbas() {
    document.querySelectorAll('.tr-tab-btn').forEach((b) => {
      b.addEventListener('click', () => { if (!b.disabled) ativarAba(b.dataset.tab); });
    });
  }

  // ----------------------- Itens de inventário -----------------------
  const ITENS_INVENTARIO = [
    { id: 'quartos', label: 'Quartos', tipo: 'qtd_marca', semMarca: true },
    { id: 'divisao_camas', label: 'Divisão de camas', tipo: 'texto' },
    { id: 'banheiros', label: 'Banheiros', tipo: 'qtd_marca', semMarca: true },
    { id: 'tv', label: 'TV', tipo: 'qtd_marca' },
    { id: 'ar_condicionado', label: 'Ar condicionado', tipo: 'qtd_marca' },
    { id: 'maquina_lavar', label: 'Máquina de lavar', tipo: 'qtd_marca' },
    { id: 'geladeira', label: 'Geladeira', tipo: 'qtd_marca' },
    { id: 'microondas', label: 'Micro-ondas', tipo: 'qtd_marca' },
    { id: 'fogao', label: 'Fogão', tipo: 'qtd_marca' },
    { id: 'bebedouro', label: 'Bebedouro', tipo: 'qtd_marca' },
    { id: 'sanduicheira', label: 'Sanduicheira', tipo: 'qtd_marca' },
    { id: 'liquidificador', label: 'Liquidificador', tipo: 'qtd_marca' },
    { id: 'cafeteira', label: 'Cafeteira', tipo: 'qtd_marca' },
    { id: 'ferro_passar', label: 'Ferro de passar', tipo: 'qtd_marca' },
    { id: 'secador_cabelo', label: 'Secador de cabelo', tipo: 'qtd_marca' },
    { id: 'chuveiro', label: 'Chuveiro', tipo: 'qtd_marca' },
    { id: 'mesa_trabalho', label: 'Mesa de trabalho', tipo: 'qtd_marca' },
    { id: 'espelho_corpo', label: 'Espelho de corpo todo', tipo: 'texto' },
    { id: 'lixo', label: 'Lixo (coleta/local)', tipo: 'texto' },
  ];

  function montarLinhasInventario(valoresAtuais = {}) {
    const container = document.getElementById('area-inventario');
    container.innerHTML = '';

    ITENS_INVENTARIO.forEach((item) => {
      const v = valoresAtuais[item.id] || {};
      const linha = document.createElement('div');
      linha.className = 'flex flex-wrap items-center gap-2 py-1.5 border-b border-slate-100 last:border-0';

      let camposExtra = '';
      if (item.tipo === 'qtd_marca') {
        camposExtra = `
          <input type="number" min="0" data-campo="qtd" value="${v.qtd ?? ''}" placeholder="qtd"
            class="tr-input w-16 rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
          ${item.semMarca ? '' : `<input type="text" data-campo="marca" value="${v.marca ?? ''}" placeholder="marca/modelo"
            class="tr-input flex-1 min-w-[140px] rounded-lg border border-slate-300 px-2 py-1.5 text-sm">`}`;
      } else {
        camposExtra = `<input type="text" data-campo="texto" value="${v.texto ?? ''}" placeholder="observação"
          class="tr-input flex-1 min-w-[140px] rounded-lg border border-slate-300 px-2 py-1.5 text-sm">`;
      }

      linha.innerHTML = `
        <label class="flex items-center gap-2 w-40 shrink-0 text-sm text-slate-700">
          <input type="checkbox" data-item="${item.id}" data-campo="tem" ${v.tem ? 'checked' : ''}
            class="rounded border-slate-300">
          ${item.label}
        </label>
        <div class="flex items-center gap-2 flex-1" data-campos-de="${item.id}">${camposExtra}</div>`;

      container.appendChild(linha);
    });
  }

  function lerValoresInventario() {
    const resultado = {};
    ITENS_INVENTARIO.forEach((item) => {
      const tem = document.querySelector(`[data-item="${item.id}"][data-campo="tem"]`).checked;
      const bloco = document.querySelector(`[data-campos-de="${item.id}"]`);
      const entrada = { tem };
      if (item.tipo === 'qtd_marca') {
        const qtd = bloco.querySelector('[data-campo="qtd"]').value;
        if (qtd) entrada.qtd = Number(qtd);
        const marca = bloco.querySelector('[data-campo="marca"]');
        if (marca && marca.value) entrada.marca = marca.value;
      } else {
        const texto = bloco.querySelector('[data-campo="texto"]').value;
        if (texto) entrada.texto = texto;
      }
      resultado[item.id] = entrada;
    });
    return resultado;
  }

  // ----------------------- Lista de imóveis -----------------------
  async function carregarProprietarios() {
    if (listaProprietariosCache.length) return listaProprietariosCache;
    const { data, error } = await supabase.from('proprietarios').select('id, nome').order('nome');
    if (error) { await mostrarAlerta('Erro ao carregar proprietários: ' + error.message, { titulo: 'Erro' }); return []; }
    listaProprietariosCache = data;
    return data;
  }

  async function preencherSelectPrincipal(selecionadoId) {
    const lista = await carregarProprietarios();
    const select = document.getElementById('im-proprietario');
    select.innerHTML = '<option value="">Selecione...</option>';
    lista.forEach((p) => {
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.nome;
      select.appendChild(opt);
    });
    if (selecionadoId) select.value = selecionadoId;
  }

  async function carregarLista() {
    // FK explícita (proprietario_id): sem isso o Supabase recusa o embed porque
    // também existe o caminho indireto via imovel_coproprietarios.
    const { data, error } = await supabase
      .from('imoveis')
      .select('id, codigo_interno, nome_referencia, proprietarios!proprietario_id(nome)')
      .order('codigo_interno');

    if (error) { await mostrarAlerta('Erro ao carregar: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-imoveis');
    tbody.innerHTML = '';
    document.getElementById('lista-vazia').classList.toggle('hidden', data.length > 0);

    data.forEach((im) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5 text-slate-500">${im.codigo_interno}</td>
        <td class="px-5 py-2.5 font-medium text-slate-800">${im.nome_referencia}</td>
        <td class="px-5 py-2.5 text-slate-500">${im.proprietarios?.nome || '—'}</td>
        <td class="px-5 py-2.5 text-right">${celulaAcoes(
          btnVisualizar(im.id, 'btn-visualizar'),
          btnEditar(im.id, 'btn-editar'),
          btnExcluir(im.id, 'btn-excluir'),
        )}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-visualizar').forEach((b) => b.addEventListener('click', () => abrirEdicao(b.dataset.id, true)));
    tbody.querySelectorAll('.btn-editar').forEach((b) => b.addEventListener('click', () => abrirEdicao(b.dataset.id, false)));
    tbody.querySelectorAll('.btn-excluir').forEach((b) => b.addEventListener('click', () => excluirImovel(b.dataset.id)));
  }

  async function excluirImovel(id) {
    const ok = await confirmarAcao('Excluir este imóvel? Só é possível se não houver reservas vinculadas a ele.', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;
    const { data: imovel } = await supabase.from('imoveis').select('nome_referencia').eq('id', id).single();
    const { error } = await supabase.from('imoveis').delete().eq('id', id);
    if (error) { await mostrarAlerta('Não foi possível excluir: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'imoveis', registroId: id, descricao: `Imóvel "${imovel?.nome_referencia || id}"` });
    carregarLista();
  }

  // ----------------------- Abrir o editor -----------------------
  function montarCorpoModal() {
    return document.getElementById('template-edicao').content.cloneNode(true);
  }

  function ligarEventosComuns() {
    aplicarVisibilidadePorPerfil(perfil); // abas/painéis com data-perfil — reavaliar após inserir no DOM
    ligarAbas();
    document.getElementById('btn-salvar-tudo').addEventListener('click', salvarTudo);
    document.getElementById('form-regra-imovel').addEventListener('submit', salvarRegraImovel);
    document.getElementById('form-coprop').addEventListener('submit', adicionarCoproprietario);
  }

  async function abrirPainelNovo() {
    imovelAtualId = null;
    const corpo = montarCorpoModal();
    abrirModal({ titulo: 'Novo imóvel', corpoEl: corpo, largura: 'sm:max-w-4xl', cheio: true });
    ligarEventosComuns();
    ativarAba('detalhes');

    document.querySelector('[data-tab="regras"]').disabled = true;
    document.getElementById('aviso-salvar-coprop').classList.remove('hidden');
    document.getElementById('area-coproprietarios').classList.add('hidden');

    await preencherSelectPrincipal(null);
    montarLinhasInventario({});
    document.getElementById('im-codigo').focus();
  }

  async function abrirEdicao(id, somenteLeitura = false) {
    const { data, error } = await supabase.from('imoveis').select('*').eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    imovelAtualId = id;
    const corpo = montarCorpoModal();
    abrirModal({
      titulo: `${somenteLeitura ? 'Visualizar' : 'Editar'} — ${data.nome_referencia}`,
      corpoEl: corpo, largura: 'sm:max-w-4xl', cheio: true,
    });
    ligarEventosComuns();
    ativarAba('detalhes');

    document.getElementById('im-codigo').value = data.codigo_interno || '';
    document.getElementById('im-nome').value = data.nome_referencia || '';
    document.getElementById('im-predio').value = data.nome_predio || '';
    document.getElementById('im-apto').value = data.apto || '';
    document.getElementById('im-andar').value = data.andar || '';
    document.getElementById('im-vaga').value = data.vaga || '';
    document.getElementById('im-endereco').value = data.endereco || '';
    await preencherSelectPrincipal(data.proprietario_id);

    montarLinhasInventario(data.inventario || {});

    const acesso = data.dados_acesso || {};
    document.getElementById('ac-provedor').value = acesso.provedor_internet || '';
    document.getElementById('ac-wifi').value = acesso.wifi || '';
    document.getElementById('ac-instrucoes').value = acesso.instrucoes || '';
    document.getElementById('ac-informativo').checked = !!acesso.informativo_porta;
    document.getElementById('ac-cofre').value = acesso.senha_cofre || '';
    document.getElementById('ac-chaves').value = acesso.qtd_chaves ?? '';

    document.querySelector('[data-tab="regras"]').disabled = false;
    await carregarRegrasImovel(id);

    document.getElementById('aviso-salvar-coprop').classList.add('hidden');
    document.getElementById('area-coproprietarios').classList.remove('hidden');
    await carregarCoproprietarios(id);

    if (somenteLeitura) bloquearImovelParaLeitura();
  }

  /** Trava o editor inteiro (as 4 abas) para o botão "Visualizar": desabilita
   * todo campo, esconde o rodapé de salvar e os formulários/ações de
   * Regras e Coproprietários — só deixa ver, nada de alterar. */
  function bloquearImovelParaLeitura() {
    document.querySelectorAll('#modal-corpo input, #modal-corpo select, #modal-corpo textarea').forEach((el) => { el.disabled = true; });
    document.getElementById('btn-salvar-tudo')?.parentElement?.classList.add('hidden');
    document.getElementById('form-regra-imovel')?.classList.add('hidden');
    document.getElementById('form-coprop')?.classList.add('hidden');
    document.querySelectorAll('#tbody-regras-imovel button, #lista-coproprietarios button').forEach((b) => { b.style.display = 'none'; });
  }

  document.getElementById('btn-novo').addEventListener('click', abrirPainelNovo);

  // ----------------------- Salvar (Detalhes + Inventário + Acesso, de uma vez) -----------------------
  async function salvarTudo() {
    const codigo = document.getElementById('im-codigo').value.trim();
    const nomeRef = document.getElementById('im-nome').value.trim();
    const proprietarioId = document.getElementById('im-proprietario').value;

    if (!codigo || !nomeRef || !proprietarioId) {
      await mostrarAlerta('Preencha código, nome/referência e proprietário principal (aba Detalhes).', { titulo: 'Campos obrigatórios' });
      ativarAba('detalhes');
      return;
    }

    const payload = {
      codigo_interno: codigo,
      nome_referencia: nomeRef,
      proprietario_id: proprietarioId,
      nome_predio: document.getElementById('im-predio').value.trim() || null,
      apto: document.getElementById('im-apto').value.trim() || null,
      andar: document.getElementById('im-andar').value.trim() || null,
      vaga: document.getElementById('im-vaga').value.trim() || null,
      endereco: document.getElementById('im-endereco').value.trim() || null,
      inventario: lerValoresInventario(),
    };

    if (podeVerAcesso) {
      payload.dados_acesso = {
        provedor_internet: document.getElementById('ac-provedor').value || null,
        wifi: document.getElementById('ac-wifi').value || null,
        instrucoes: document.getElementById('ac-instrucoes').value || null,
        informativo_porta: document.getElementById('ac-informativo').checked,
        senha_cofre: document.getElementById('ac-cofre').value || null,
        qtd_chaves: document.getElementById('ac-chaves').value ? Number(document.getElementById('ac-chaves').value) : null,
      };
    }

    const btn = document.getElementById('btn-salvar-tudo');
    btn.disabled = true;
    btn.textContent = 'Salvando...';

    if (imovelAtualId) {
      const { error } = await supabase.from('imoveis').update(payload).eq('id', imovelAtualId);
      btn.disabled = false;
      btn.textContent = 'Salvar alterações';
      if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
      document.getElementById('status-salvamento').textContent =
        `Salvo às ${new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}`;
      await registrarLog({ acao: 'editar', tabela: 'imoveis', registroId: imovelAtualId, descricao: `Imóvel "${nomeRef}" (${codigo})` });
    } else {
      const { data, error } = await supabase.from('imoveis').insert(payload).select().single();
      btn.disabled = false;
      btn.textContent = 'Salvar alterações';
      if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }

      imovelAtualId = data.id;
      document.getElementById('modal-titulo').textContent = `Editar — ${data.nome_referencia}`;
      document.getElementById('status-salvamento').textContent = 'Imóvel criado.';
      document.querySelector('[data-tab="regras"]').disabled = false;
      document.getElementById('aviso-salvar-coprop').classList.add('hidden');
      document.getElementById('area-coproprietarios').classList.remove('hidden');
      carregarRegrasImovel(imovelAtualId);
      carregarCoproprietarios(imovelAtualId);
      await registrarLog({ acao: 'criar', tabela: 'imoveis', registroId: data.id, descricao: `Imóvel "${nomeRef}" (${codigo})` });
    }

    carregarLista();
  }

  // ----------------------- Coproprietários -----------------------
  async function carregarCoproprietarios(imovelId) {
    const { data, error } = await supabase
      .from('imovel_coproprietarios')
      .select('proprietario_id, proprietarios(nome)')
      .eq('imovel_id', imovelId);

    if (error) { await mostrarAlerta('Erro ao carregar coproprietários: ' + error.message, { titulo: 'Erro' }); return; }

    const lista = document.getElementById('lista-coproprietarios');
    if (!lista) return;
    lista.innerHTML = '';
    data.forEach((c) => {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between py-1.5';
      li.innerHTML = `
        <span class="text-slate-700">${c.proprietarios?.nome || '—'}</span>
        <button data-id="${c.proprietario_id}" class="btn-remover-coprop text-xs text-red-600 hover:underline">Remover</button>`;
      lista.appendChild(li);
    });
    lista.querySelectorAll('.btn-remover-coprop').forEach((b) =>
      b.addEventListener('click', () => removerCoproprietario(b.dataset.id)));

    await atualizarOpcoesCoprop(data.map((c) => c.proprietario_id));
  }

  async function atualizarOpcoesCoprop(idsJaAdicionados) {
    const principal = document.getElementById('im-proprietario').value;
    const todos = await carregarProprietarios();
    const select = document.getElementById('coprop-select');
    if (!select) return;
    select.innerHTML = '';
    const disponiveis = todos.filter((p) => p.id !== principal && !idsJaAdicionados.includes(p.id));
    if (!disponiveis.length) {
      select.innerHTML = '<option value="">Nenhum proprietário disponível</option>';
      select.disabled = true;
      return;
    }
    select.disabled = false;
    disponiveis.forEach((p) => {
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.nome;
      select.appendChild(opt);
    });
  }

  async function adicionarCoproprietario(e) {
    e.preventDefault();
    if (!imovelAtualId) return;
    const proprietarioId = document.getElementById('coprop-select').value;
    if (!proprietarioId) return;

    const { error } = await supabase.from('imovel_coproprietarios').insert({
      imovel_id: imovelAtualId,
      proprietario_id: proprietarioId,
    });

    if (error) { await mostrarAlerta('Erro ao adicionar: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'criar', tabela: 'imovel_coproprietarios', registroId: imovelAtualId, descricao: 'Coproprietário adicionado ao imóvel' });
    carregarCoproprietarios(imovelAtualId);
  }

  async function removerCoproprietario(proprietarioId) {
    const ok = await confirmarAcao('Remover este coproprietário do imóvel?', { perigo: true, textoConfirmar: 'Remover' });
    if (!ok) return;
    const { error } = await supabase
      .from('imovel_coproprietarios')
      .delete()
      .eq('imovel_id', imovelAtualId)
      .eq('proprietario_id', proprietarioId);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'imovel_coproprietarios', registroId: imovelAtualId, descricao: 'Coproprietário removido do imóvel' });
    carregarCoproprietarios(imovelAtualId);
  }

  // ----------------------- Regras específicas do imóvel -----------------------
  const rotuloTipoRegra = { comissao: 'Comissão', limpeza: 'Limpeza' };

  async function carregarRegrasImovel(imovelId) {
    const { data, error } = await supabase
      .from('imovel_parametros')
      .select('*')
      .eq('imovel_id', imovelId)
      .order('tipo')
      .order('vigencia_inicio', { ascending: false });

    if (error) { await mostrarAlerta('Erro ao carregar regras do imóvel: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-regras-imovel');
    if (!tbody) return;
    tbody.innerHTML = '';
    data.forEach((r) => {
      const valorTexto = r.percentual != null ? fmtPercentual(r.percentual) : fmtMoeda(r.valor);
      const vigenciaTexto = `${r.vigencia_inicio} ${r.vigencia_fim ? '→ ' + r.vigencia_fim : '(em vigor)'}`;
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="py-2">${rotuloTipoRegra[r.tipo] || r.tipo}</td>
        <td class="py-2">${valorTexto}</td>
        <td class="py-2 text-slate-500">${vigenciaTexto}</td>
        <td class="py-2 text-right">
          ${r.vigencia_fim ? '' : `<button data-id="${r.id}" class="btn-encerrar-regra text-xs text-amber-600 hover:underline mr-3">Encerrar</button>`}
          <button data-id="${r.id}" class="btn-excluir-regra text-xs text-red-600 hover:underline">Excluir</button>
        </td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-encerrar-regra').forEach((b) => b.addEventListener('click', () => encerrarRegraImovel(b.dataset.id)));
    tbody.querySelectorAll('.btn-excluir-regra').forEach((b) => b.addEventListener('click', () => excluirRegraImovel(b.dataset.id)));
  }

  async function salvarRegraImovel(e) {
    e.preventDefault();
    if (!imovelAtualId) return;

    const percentualInput = document.getElementById('ri-percentual').value;
    const valorInput = document.getElementById('ri-valor').value;
    if (!percentualInput && !valorInput) {
      await mostrarAlerta('Informe um percentual ou um valor fixo.', { titulo: 'Campo obrigatório' });
      return;
    }

    const tipoRegra = document.getElementById('ri-tipo').value;
    const { data: salvo, error } = await supabase.from('imovel_parametros').insert({
      imovel_id: imovelAtualId,
      tipo: tipoRegra,
      percentual: percentualInput ? Number(percentualInput) / 100 : null,
      valor: valorInput ? Number(valorInput) : null,
      vigencia_inicio: document.getElementById('ri-inicio').value || hoje(),
    }).select().single();

    if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({
      acao: 'criar', tabela: 'imovel_parametros', registroId: salvo.id,
      descricao: `Exceção de ${rotuloTipoRegra[tipoRegra] || tipoRegra} cadastrada para o imóvel`,
    });
    e.target.reset();
    carregarRegrasImovel(imovelAtualId);
  }

  async function encerrarRegraImovel(id) {
    const ok = await confirmarAcao('Encerrar a vigência desta regra hoje?');
    if (!ok) return;
    const { error } = await supabase.from('imovel_parametros').update({ vigencia_fim: hoje() }).eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'editar', tabela: 'imovel_parametros', registroId: id, descricao: 'Vigência de exceção do imóvel encerrada' });
    carregarRegrasImovel(imovelAtualId);
  }

  async function excluirRegraImovel(id) {
    const ok = await confirmarAcao('Excluir esta regra definitivamente?', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;
    const { error } = await supabase.from('imovel_parametros').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'imovel_parametros', registroId: id, descricao: 'Exceção do imóvel excluída' });
    carregarRegrasImovel(imovelAtualId);
  }

  carregarLista();
</script>
</body>
</html>
</file>

<file path="app/parametros.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Parâmetros — TR Serviços de Reservas</title>
<link rel="icon" type="image/svg+xml" href="../assets/img/logo.svg">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/css/theme.css">
</head>
<body class="min-h-screen bg-slate-50">

  <div class="flex flex-col sm:flex-row min-h-screen">

    <!-- Barra superior (só mobile) -->
    <header class="sm:hidden flex items-center justify-between px-4 py-3 tr-bg-azul text-white sticky top-0 z-20">
      <button id="btn-menu-abrir" aria-label="Abrir menu" aria-expanded="false" class="p-1 -ml-1">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </button>
      <div class="flex items-center gap-2">
        <div class="tr-logo-ring rounded-md w-7 h-7 flex items-center justify-center">
          <span class="text-xs font-extrabold"><span style="color: var(--tr-verde)">T</span><span class="text-white">R</span></span>
        </div>
        <span class="text-sm font-semibold">TR Reservas</span>
      </div>
      <span class="w-6" aria-hidden="true"></span>
    </header>

    <!-- Fundo escurecido atrás do menu aberto (só mobile) -->
    <div id="sidebar-overlay" class="hidden sm:hidden fixed inset-0 bg-black/40 z-30"></div>

    <!-- Menu lateral: off-canvas em mobile, fixo a partir de sm -->
    <aside id="sidebar"
      class="fixed sm:static inset-y-0 left-0 z-40 w-64 sm:w-56 shrink-0 tr-bg-azul text-white flex flex-col -translate-x-full sm:translate-x-0 transition-transform duration-200">
      <div class="flex items-center justify-between gap-2 px-4 py-4">
        <div class="flex items-center gap-2">
          <div class="tr-logo-ring rounded-md w-8 h-8 flex items-center justify-center shrink-0">
            <span class="text-sm font-extrabold">
              <span style="color: var(--tr-verde)">T</span><span class="text-white">R</span>
            </span>
          </div>
          <span class="text-sm font-semibold">TR Reservas</span>
        </div>
        <button id="btn-menu-fechar" aria-label="Fechar menu" class="sm:hidden p-1 text-white/80 hover:text-white">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
        </button>
      </div>

      <nav class="flex-1 px-2 space-y-1 text-sm">
        <a href="dashboard.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg><span>Dashboard</span></a>
        <a href="reservas.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span>Reservas</span></a>
        <a href="imoveis.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg><span>Imóveis</span></a>
