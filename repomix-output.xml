:root {
  --tr-azul: #004AAD;
  --tr-azul-claro: #1f63c9;
  --tr-azul-escuro: #003a87;
  --tr-verde: #7ED956;
  --tr-verde-escuro: #63b741;
  --tr-branco: #FFFFFF;
  --tr-cinza-texto: #1e293b;
}

html, body { height: 100%; }
body {
  font-family: 'Manrope', system-ui, sans-serif;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  -webkit-font-smoothing: antialiased;
}

/* Fundo com leve gradiente — menos chapado que uma cor sólida */
.tr-bg-azul {
  background: linear-gradient(165deg, var(--tr-azul-claro) 0%, var(--tr-azul) 45%, var(--tr-azul-escuro) 100%);
}
.tr-bg-verde     { background: var(--tr-verde); }
.tr-text-azul    { color: var(--tr-azul); }

.tr-btn {
  background: var(--tr-verde);
  color: #0b2e05;
  box-shadow: 0 1px 2px rgba(15,23,42,0.06);
  transition: background-color .15s ease, box-shadow .15s ease, transform .1s ease;
}
.tr-btn:hover  { background: var(--tr-verde-escuro); box-shadow: 0 6px 14px -4px rgba(99,183,65,0.5); transform: translateY(-1px); }
.tr-btn:active { transform: translateY(0); box-shadow: 0 1px 2px rgba(15,23,42,0.08); }
.tr-btn:disabled { opacity: .55; cursor: not-allowed; transform: none; box-shadow: none; }

.tr-input {
  transition: border-color .15s ease, box-shadow .15s ease;
}
.tr-input:focus {
  outline: none;
  border-color: var(--tr-verde);
  box-shadow: 0 0 0 3px rgba(126,217,86,0.28);
}

.tr-logo-ring { border: 3px solid var(--tr-branco); }

/* Cartão padrão das listas/seções — substitui "bg-white rounded-xl border
   border-slate-200" repetido em toda tela, com sombra suave e leve elevação
   ao passar o mouse (sensação menos "chapada"). */
