  function cancelarEdicaoDespesa() {
    despesaEditandoId = null;
    document.getElementById('form-despesa').reset();
    document.getElementById('ds-parcelas').value = 1;
    document.getElementById('ds-btn-salvar').textContent = 'Adicionar';
    document.getElementById('ds-btn-cancelar').classList.add('hidden');
  }

  async function iniciarEdicaoDespesa(id) {
    const { data: d, error } = await supabase.from('despesas_tr').select('*').eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    despesaEditandoId = id;
    document.getElementById('ds-data').value = d.data;
    document.getElementById('ds-item').value = d.item;
    document.getElementById('ds-forma').value = d.forma_pagamento || '';
    document.getElementById('ds-valor').value = d.valor;
    document.getElementById('ds-parcelas').value = d.num_parcelas;
    document.getElementById('ds-btn-salvar').textContent = 'Salvar alterações';
    document.getElementById('ds-btn-cancelar').classList.remove('hidden');
    document.getElementById('ds-data').scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  document.getElementById('ds-btn-cancelar').addEventListener('click', cancelarEdicaoDespesa);

  document.getElementById('form-despesa').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = document.getElementById('ds-data').value;
    const valor = Number(document.getElementById('ds-valor').value || 0);
    const numParcelas = Number(document.getElementById('ds-parcelas').value || 1);
    const editando = !!despesaEditandoId;

    const parcelasNovas = ratearDespesa({ data, valor, numParcelas });
    let mesesAfetados = parcelasNovas.map((p) => p.mesReferencia);

    // Editando: os meses das parcelas antigas também podem precisar de aviso/recálculo.
    if (editando) {
      const { data: parcelasAntigas, error: erroBusca } = await supabase
        .from('despesa_parcelas').select('mes_referencia').eq('despesa_id', despesaEditandoId);
      if (erroBusca) { await mostrarAlerta('Erro: ' + erroBusca.message, { titulo: 'Erro' }); return; }
      mesesAfetados = [...new Set([...mesesAfetados, ...(parcelasAntigas || []).map((p) => p.mes_referencia)])];
    }

    const podeProsseguir = await confirmarSeMesFechado(mesesAfetados, confirmarAcao);
    if (!podeProsseguir) return;

    const payload = {
      data,
      item: document.getElementById('ds-item').value.trim(),
      forma_pagamento: document.getElementById('ds-forma').value.trim() || null,
      valor,
      num_parcelas: numParcelas,
    };

    let despesaId = despesaEditandoId;
    if (editando) {
      const { error } = await supabase.from('despesas_tr').update(payload).eq('id', despesaEditandoId);
      if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
      // Refaz as parcelas do zero — valor/data/parcelas podem ter mudado.
      const { error: erroLimpa } = await supabase.from('despesa_parcelas').delete().eq('despesa_id', despesaEditandoId);
      if (erroLimpa) { await mostrarAlerta('Erro ao atualizar parcelas: ' + erroLimpa.message, { titulo: 'Erro' }); return; }
    } else {
      const { data: despesa, error } = await supabase.from('despesas_tr').insert(payload).select().single();
      if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
      despesaId = despesa.id;
    }

    const parcelas = parcelasNovas.map((p) => ({
      despesa_id: despesaId,
      mes_referencia: p.mesReferencia,
      valor_parcela: p.valorParcela,
    }));
    const { error: erroParcelas } = await supabase.from('despesa_parcelas').insert(parcelas);
    if (erroParcelas) await mostrarAlerta('Despesa salva, mas houve um erro ao gerar as parcelas: ' + erroParcelas.message, { titulo: 'Atenção' });

    await recalcularFechamentosFechados(mesesAfetados);
    await registrarLog({
      acao: editando ? 'editar' : 'criar', tabela: 'despesas_tr', registroId: despesaId,
      descricao: `Despesa "${payload.item}" de ${fmtMoeda(valor)} (${numParcelas}×)`,
    });
    cancelarEdicaoDespesa();
    carregarDespesas();
  });

  async function excluirDespesa(id) {
    const ok = await confirmarAcao('Excluir esta despesa? As parcelas geradas também serão removidas.', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;

    const { data: despesa, error: erroDespesa } = await supabase.from('despesas_tr').select('item, valor').eq('id', id).single();
    if (erroDespesa) { await mostrarAlerta('Erro: ' + erroDespesa.message, { titulo: 'Erro' }); return; }

    const { data: parcelasExistentes, error: erroBusca } = await supabase
      .from('despesa_parcelas').select('mes_referencia').eq('despesa_id', id);
    if (erroBusca) { await mostrarAlerta('Erro: ' + erroBusca.message, { titulo: 'Erro' }); return; }
    const mesesAfetados = (parcelasExistentes || []).map((p) => p.mes_referencia);

    const podeProsseguir = await confirmarSeMesFechado(mesesAfetados, confirmarAcao);
    if (!podeProsseguir) return;

    const { error } = await supabase.from('despesas_tr').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    await recalcularFechamentosFechados(mesesAfetados);
    await registrarLog({
      acao: 'excluir', tabela: 'despesas_tr', registroId: id,
      descricao: `Despesa "${despesa.item}" de ${fmtMoeda(despesa.valor)}`,
    });
    carregarDespesas();
  }

