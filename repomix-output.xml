<script type="module">
  import { exigirSessao, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { abrirModal, mostrarAlerta, confirmarAcao, exibirDetalhes } from '../assets/js/modal.js';
  import { calcularComissao, dividirCompetencia, confirmarSeMesFechado, recalcularFechamentosFechados } from '../assets/js/calculo.js';
  import { registrarLog } from '../assets/js/log.js';
  import { celulaAcoes, btnVisualizar, btnEditar, btnExcluir } from '../assets/js/icones.js';

  initSidebarMobile();

  const { nome, perfil } = await exigirSessao();
  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  const fmtMoeda = (v) => (v ?? 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const fmtData = (iso) => new Date(iso + 'T00:00:00').toLocaleDateString('pt-BR');
  const mesmoMes = (a, b) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth();

  let imoveisCache = []; // [{id, codigo_interno, nome_referencia, proprietario_id}]

  async function carregarImoveis() {
    if (imoveisCache.length) return imoveisCache;
    const { data, error } = await supabase
      .from('imoveis')
      .select('id, codigo_interno, nome_referencia, proprietario_id')
      .order('nome_referencia');
    if (error) { await mostrarAlerta('Erro ao carregar imóveis: ' + error.message, { titulo: 'Erro' }); return []; }
    imoveisCache = data;
    return data;
  }

  async function preencherSelectImoveis(selectEl, incluirTodos = false) {
    const imoveis = await carregarImoveis();
    selectEl.innerHTML = incluirTodos ? '<option value="">Todos os imóveis</option>' : '<option value="">Selecione...</option>';
    imoveis.forEach((im) => {
      const opt = document.createElement('option');
      opt.value = im.id;
      opt.textContent = `${im.nome_referencia} (${im.codigo_interno})`;
      selectEl.appendChild(opt);
    });
  }

  async function carregarCanais(selectEl) {
    const { data, error } = await supabase.from('canais_venda').select('id, nome').order('nome');
    if (error) { await mostrarAlerta('Erro ao carregar canais: ' + error.message, { titulo: 'Erro' }); return; }
    selectEl.innerHTML = '<option value="">Selecione...</option>';
    data.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.nome;
      selectEl.appendChild(opt);
    });
    // Padrão: TR (a planilha não registra mais o canal de venda por reserva).
    const optTR = Array.from(selectEl.options).find((o) => o.textContent.trim().toUpperCase() === 'TR');
    if (optTR) selectEl.value = optTR.value;
  }

  async function carregarContasDoImovel(imovelId, selectEl) {
    selectEl.innerHTML = '<option value="">Sem conta definida</option>';
    if (!imovelId) return;
    const imovel = imoveisCache.find((im) => im.id === imovelId);
    if (!imovel) return;
    const { data, error } = await supabase
      .from('contas_bancarias')
      .select('id, favorecido, tipo, padrao')
      .eq('proprietario_id', imovel.proprietario_id)
      .order('padrao', { ascending: false });
    if (error) { await mostrarAlerta('Erro ao carregar contas: ' + error.message, { titulo: 'Erro' }); return; }
    data.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = `${c.favorecido} — ${c.tipo}${c.padrao ? ' (padrão)' : ''}`;
      selectEl.appendChild(opt);
    });
  }

  // ----------------------- Filtros e lista de reservas -----------------------
  async function inicializarFiltros() {
    await preencherSelectImoveis(document.getElementById('filtro-imovel'), true);
    document.getElementById('filtro-imovel').addEventListener('change', carregarReservas);
    document.getElementById('filtro-mes').addEventListener('change', carregarReservas);
    document.getElementById('btn-limpar-filtros').addEventListener('click', () => {
      document.getElementById('filtro-imovel').value = '';
      document.getElementById('filtro-mes').value = '';
      carregarReservas();
    });
  }

  async function carregarReservas() {
    let query = supabase
      .from('reservas')
      .select('id, hospede, data_entrada, data_saida, valor_bruto, valor_comissao, valor_proprietario, imoveis!imovel_id(nome_referencia)')
      .order('data_entrada', { ascending: false })
      .limit(100);

    const imovelId = document.getElementById('filtro-imovel').value;
    if (imovelId) query = query.eq('imovel_id', imovelId);

    const mes = document.getElementById('filtro-mes').value; // 'YYYY-MM'
    if (mes) {
      const inicio = `${mes}-01`;
      const [ano, mesNum] = mes.split('-').map(Number);
      const fim = mesNum === 12 ? `${ano + 1}-01-01` : `${ano}-${String(mesNum + 1).padStart(2, '0')}-01`;
      query = query.gte('data_entrada', inicio).lt('data_entrada', fim);
    }

    const { data, error } = await query;
    if (error) { await mostrarAlerta('Erro ao carregar reservas: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-reservas');
    tbody.innerHTML = '';
    document.getElementById('lista-vazia').classList.toggle('hidden', data.length > 0);

    data.forEach((r) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5 font-medium text-slate-800">${r.imoveis?.nome_referencia || '—'}</td>
        <td class="px-5 py-2.5 text-slate-600">${r.hospede}</td>
        <td class="px-5 py-2.5 text-slate-500">${fmtData(r.data_entrada)}</td>
        <td class="px-5 py-2.5 text-slate-500">${fmtData(r.data_saida)}</td>
        <td class="px-5 py-2.5 text-right">${fmtMoeda(r.valor_bruto)}</td>
        <td class="px-5 py-2.5 text-right text-slate-500">${fmtMoeda(r.valor_comissao)}</td>
        <td class="px-5 py-2.5 text-right text-slate-500">${fmtMoeda(r.valor_proprietario)}</td>
        <td class="px-5 py-2.5 text-right">${celulaAcoes(
          btnVisualizar(r.id, 'btn-visualizar-reserva'),
          btnEditar(r.id, 'btn-editar-reserva'),
          btnExcluir(r.id, 'btn-excluir-reserva'),
        )}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-visualizar-reserva').forEach((b) => b.addEventListener('click', () => visualizarReserva(b.dataset.id)));
    tbody.querySelectorAll('.btn-editar-reserva').forEach((b) => b.addEventListener('click', () => abrirModalEditarReserva(b.dataset.id)));
    tbody.querySelectorAll('.btn-excluir-reserva').forEach((b) => b.addEventListener('click', () => excluirReserva(b.dataset.id)));
  }

  async function visualizarReserva(id) {
    const { data: r, error } = await supabase
      .from('reservas')
      .select('*, imoveis!imovel_id(nome_referencia), canais_venda(nome), contas_bancarias(favorecido, tipo)')
      .eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    const regra = r.regra_comissao_aplicada;
    const regraTexto = r.ajuste_manual
      ? 'Ajuste manual'
      : regra?.nivel
        ? `${regra.percentual != null ? (regra.percentual * 100).toFixed(0) + '%' : fmtMoeda(regra.valor)} · regra do ${regra.nivel === 'imovel' ? 'imóvel' : 'parâmetro geral'}`
        : '—';

    exibirDetalhes({
      titulo: `Reserva — ${r.hospede}`,
      campos: [
        { label: 'Imóvel', valor: r.imoveis?.nome_referencia },
        { label: 'Hóspede', valor: r.hospede },
        { label: 'Canal', valor: r.canais_venda?.nome },
        { label: 'Check-in', valor: fmtData(r.data_entrada) },
        { label: 'Check-out', valor: fmtData(r.data_saida) },
        { label: 'Noites', valor: Math.round((new Date(r.data_saida) - new Date(r.data_entrada)) / 86400000) },
        { label: 'Valor total', valor: fmtMoeda(r.valor_bruto) },
        { label: 'Limpeza', valor: fmtMoeda(r.valor_limpeza) },
        { label: 'Comissão', valor: fmtMoeda(r.valor_comissao) },
        { label: 'Regra de comissão', valor: regraTexto },
        { label: 'Repasse ao proprietário', valor: fmtMoeda(r.valor_proprietario) },
        { label: 'Conta de repasse', valor: r.contas_bancarias ? `${r.contas_bancarias.favorecido} (${r.contas_bancarias.tipo})` : null },
        { label: 'Nota fiscal', valor: r.numero_nf },
        { label: 'Observação', valor: r.observacao },
        ...(r.ajuste_manual ? [{ label: 'Justificativa do ajuste', valor: r.justificativa_ajuste }] : []),
      ],
    });
  }

  async function excluirReserva(id) {
    const ok = await confirmarAcao('Excluir esta reserva? Isso também libera as datas no calendário do imóvel.', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;

    const { data: reserva, error: erroBusca } = await supabase
      .from('reservas').select('hospede, data_entrada, data_saida').eq('id', id).single();
    if (erroBusca) { await mostrarAlerta('Erro: ' + erroBusca.message, { titulo: 'Erro' }); return; }

    const podeProsseguir = await confirmarSeMesFechado([reserva.data_entrada, reserva.data_saida], confirmarAcao);
    if (!podeProsseguir) return;

    const { error } = await supabase.from('reservas').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro ao excluir: ' + error.message, { titulo: 'Erro' }); return; }

    await recalcularFechamentosFechados([reserva.data_entrada, reserva.data_saida]);
    await registrarLog({
      acao: 'excluir', tabela: 'reservas', registroId: id,
      descricao: `Reserva de ${reserva.hospede} (${reserva.data_entrada} a ${reserva.data_saida})`,
    });
    carregarReservas();
  }

  // ----------------------- Nova reserva / Editar reserva (plataforma) -----------------------
  let timerPreview = null;
  let reservaEditandoId = null;
  let reservaEditandoDatasOriginais = null; // { data_entrada, data_saida } — só quando editando

  function lerCamposReserva() {
    return {
      imovelId: document.getElementById('rv-imovel').value,
      dataEntrada: document.getElementById('rv-entrada').value,
      dataSaida: document.getElementById('rv-saida').value,
      valorBruto: Number(document.getElementById('rv-valor').value || 0),
      valorLimpeza: Number(document.getElementById('rv-limpeza').value || 0),
      ajusteManual: document.getElementById('rv-ajuste').checked,
      comissaoManual: Number(document.getElementById('rv-comissao-manual').value || 0),
    };
  }

  function agendarPreview() {
    clearTimeout(timerPreview);
    timerPreview = setTimeout(atualizarPreview, 350);
  }

  async function atualizarPreview() {
    const caixa = document.getElementById('preview-calculo');
    const { imovelId, dataEntrada, dataSaida, valorBruto, valorLimpeza, ajusteManual, comissaoManual } = lerCamposReserva();

    if (!imovelId || !dataEntrada || !dataSaida || !valorBruto) {
      caixa.innerHTML = '<p class="text-slate-400">Preencha imóvel, datas e valores para ver o cálculo.</p>';
      return;
    }
    if (dataSaida <= dataEntrada) {
      caixa.innerHTML = '<p class="text-red-600">A data de saída deve ser depois da entrada.</p>';
      return;
    }

    const entrada = new Date(dataEntrada + 'T00:00:00');
    const saida = new Date(dataSaida + 'T00:00:00');
    const noites = Math.round((saida - entrada) / 86400000);

    let comissao, regraTexto;
    if (ajusteManual) {
      comissao = comissaoManual;
      regraTexto = 'ajuste manual';
    } else {
      const resultado = await calcularComissao({ valorBruto, valorLimpeza, imovelId, dataRef: dataEntrada });
      comissao = resultado.comissao;
      regraTexto = resultado.regraAplicada.nivel
        ? `${resultado.regraAplicada.percentual != null ? (resultado.regraAplicada.percentual * 100).toFixed(0) + '%' : fmtMoeda(resultado.regraAplicada.valor)} · regra do ${resultado.regraAplicada.nivel === 'imovel' ? 'imóvel' : 'parâmetro geral'}`
        : 'nenhuma regra cadastrada — comissão zerada';
    }

    const valorProprietario = valorBruto - valorLimpeza - comissao;

    let html = `
      <div class="grid grid-cols-3 gap-3 text-center">
        <div><p class="text-xs text-slate-400">Noites</p><p class="font-semibold text-slate-800">${noites}</p></div>
        <div><p class="text-xs text-slate-400">Comissão</p><p class="font-semibold text-slate-800">${fmtMoeda(comissao)}</p></div>
        <div><p class="text-xs text-slate-400">Repasse</p><p class="font-semibold text-slate-800">${fmtMoeda(valorProprietario)}</p></div>
      </div>
      <p class="text-xs text-slate-400 mt-2 text-center">${regraTexto}</p>`;

    if (!mesmoMes(entrada, saida)) {
      const diarias = valorBruto - valorLimpeza;
      const divisao = dividirCompetencia({ dataEntrada, dataSaida, valorBruto: diarias, valorComissao: comissao, valorLimpeza });
      html += `
        <div class="mt-3 pt-3 border-t border-slate-200">
          <p class="text-xs font-medium text-slate-600 mb-2">Atravessa virada de mês — divisão de competência:</p>
          <table class="w-full text-xs">
            <thead><tr class="text-slate-400"><th class="text-left font-medium">Mês</th><th class="text-right font-medium">Noites</th><th class="text-right font-medium">Repasse</th></tr></thead>
            <tbody>
              ${divisao.map((l) => `<tr><td>${l.mesReferencia.slice(0, 7)}</td><td class="text-right">${l.noites}</td><td class="text-right">${fmtMoeda(l.valorProprietarioMes)}</td></tr>`).join('')}
            </tbody>
          </table>
        </div>`;
    }

    caixa.innerHTML = html;
  }

  function ligarPreview() {
    ['rv-imovel', 'rv-entrada', 'rv-saida', 'rv-valor', 'rv-limpeza', 'rv-ajuste', 'rv-comissao-manual'].forEach((id) => {
      document.getElementById(id).addEventListener('input', agendarPreview);
      document.getElementById(id).addEventListener('change', agendarPreview);
    });
    document.getElementById('rv-ajuste').addEventListener('change', (e) => {
      document.getElementById('area-ajuste').classList.toggle('hidden', !e.target.checked);
    });
    document.getElementById('rv-imovel').addEventListener('change', (e) => {
      carregarContasDoImovel(e.target.value, document.getElementById('rv-conta'));
    });
  }

  async function abrirModalNovaReserva() {
    reservaEditandoId = null;
    reservaEditandoDatasOriginais = null;

    const corpo = document.getElementById('template-reserva').content.cloneNode(true);
    abrirModal({ titulo: 'Nova reserva', corpoEl: corpo, largura: 'max-w-xl' });

    await preencherSelectImoveis(document.getElementById('rv-imovel'));
    await carregarCanais(document.getElementById('rv-canal'));
    ligarPreview();
    document.getElementById('form-reserva').addEventListener('submit', salvarReserva);
  }

  async function abrirModalEditarReserva(id) {
    const { data: r, error } = await supabase.from('reservas').select('*').eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    reservaEditandoId = id;
    reservaEditandoDatasOriginais = { data_entrada: r.data_entrada, data_saida: r.data_saida };

    const corpo = document.getElementById('template-reserva').content.cloneNode(true);
    abrirModal({ titulo: 'Editar reserva', corpoEl: corpo, largura: 'max-w-xl' });

    await preencherSelectImoveis(document.getElementById('rv-imovel'));
    await carregarCanais(document.getElementById('rv-canal'));
    ligarPreview();

    document.getElementById('rv-imovel').value = r.imovel_id;
    document.getElementById('rv-hospede').value = r.hospede || '';
    document.getElementById('rv-canal').value = r.canal_id || '';
    document.getElementById('rv-entrada').value = r.data_entrada;
    document.getElementById('rv-saida').value = r.data_saida;
    document.getElementById('rv-valor').value = r.valor_bruto;
    document.getElementById('rv-limpeza').value = r.valor_limpeza;
    document.getElementById('rv-nf').value = r.numero_nf || '';
    document.getElementById('rv-observacao').value = r.observacao || '';
    document.getElementById('rv-ajuste').checked = r.ajuste_manual;
    if (r.ajuste_manual) {
      document.getElementById('area-ajuste').classList.remove('hidden');
      document.getElementById('rv-comissao-manual').value = r.valor_comissao;
      document.getElementById('rv-justificativa').value = r.justificativa_ajuste || '';
    }

    await carregarContasDoImovel(r.imovel_id, document.getElementById('rv-conta'));
    document.getElementById('rv-conta').value = r.conta_bancaria_id || '';

    document.querySelector('#form-reserva button[type="submit"]').textContent = 'Salvar alterações';
    document.getElementById('form-reserva').addEventListener('submit', salvarReserva);
    atualizarPreview();
  }

  async function salvarReserva(e) {
    e.preventDefault();
    const { imovelId, dataEntrada, dataSaida, valorBruto, valorLimpeza, ajusteManual, comissaoManual } = lerCamposReserva();

    if (dataSaida <= dataEntrada) {
      await mostrarAlerta('A data de saída deve ser depois da entrada.', { titulo: 'Datas inválidas' });
      return;
    }
    if (ajusteManual && !document.getElementById('rv-justificativa').value.trim()) {
      await mostrarAlerta('Informe a justificativa do ajuste manual.', { titulo: 'Campo obrigatório' });
      return;
    }

    // Ao editar, qualquer um dos dois períodos (antes ou depois da edição)
    // pode cair num mês fechado — avisa se qualquer um dos dois cair.
    const datasParaChecar = reservaEditandoDatasOriginais
      ? [dataEntrada, dataSaida, reservaEditandoDatasOriginais.data_entrada, reservaEditandoDatasOriginais.data_saida]
      : [dataEntrada, dataSaida];
    const podeProsseguir = await confirmarSeMesFechado(datasParaChecar, confirmarAcao);
    if (!podeProsseguir) return;

    let comissao, regraAplicada;
    if (ajusteManual) {
      comissao = comissaoManual;
      regraAplicada = { nivel: 'manual' };
    } else {
      const resultado = await calcularComissao({ valorBruto, valorLimpeza, imovelId, dataRef: dataEntrada });
      comissao = resultado.comissao;
      regraAplicada = resultado.regraAplicada;
    }
    const valorProprietario = valorBruto - valorLimpeza - comissao;

    const payload = {
      imovel_id: imovelId,
      canal_id: document.getElementById('rv-canal').value || null,
      hospede: document.getElementById('rv-hospede').value.trim(),
      data_entrada: dataEntrada,
      data_saida: dataSaida,
      valor_bruto: valorBruto,
      valor_limpeza: valorLimpeza,
      valor_comissao: comissao,
      valor_proprietario: valorProprietario,
      regra_comissao_aplicada: regraAplicada,
      numero_nf: document.getElementById('rv-nf').value.trim() || null,
      conta_bancaria_id: document.getElementById('rv-conta').value || null,
      observacao: document.getElementById('rv-observacao').value.trim() || null,
      ajuste_manual: ajusteManual,
      justificativa_ajuste: ajusteManual ? document.getElementById('rv-justificativa').value.trim() : null,
    };

    const editando = !!reservaEditandoId;
    const btn = e.target.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = 'Salvando...';

    const { data, error } = editando
      ? await supabase.from('reservas').update(payload).eq('id', reservaEditandoId).select().single()
      : await supabase.from('reservas').insert(payload).select().single();

    btn.disabled = false;
    btn.textContent = editando ? 'Salvar alterações' : 'Salvar reserva';

    if (error) {
      if (error.code === '23P01' || (error.message || '').includes('sem_overbooking')) {
        await mostrarAlerta('Já existe uma reserva nesse imóvel que se sobrepõe a essas datas. Verifique o calendário e ajuste o período.', { titulo: 'Datas indisponíveis' });
      } else {
        await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' });
      }
      return;
    }

    // Recria a divisão de competência do zero (se estava editando, a divisão
    // antiga pode não valer mais — datas/valores podem ter mudado).
    if (editando) {
      const { error: erroLimpa } = await supabase.from('reserva_competencias').delete().eq('reserva_id', data.id);
      if (erroLimpa) await mostrarAlerta('Reserva salva, mas houve um erro ao limpar a divisão por mês anterior: ' + erroLimpa.message, { titulo: 'Atenção' });
    }

    const entrada = new Date(dataEntrada + 'T00:00:00');
    const saida = new Date(dataSaida + 'T00:00:00');
    if (!mesmoMes(entrada, saida)) {
      const diarias = valorBruto - valorLimpeza;
      const divisao = dividirCompetencia({ dataEntrada, dataSaida, valorBruto: diarias, valorComissao: comissao, valorLimpeza });
      const linhas = divisao.map((l) => ({
        reserva_id: data.id,
        mes_referencia: l.mesReferencia,
        noites: l.noites,
        valor_bruto_mes: l.valorBrutoMes,
        valor_comissao_mes: l.valorComissaoMes,
        valor_proprietario_mes: l.valorProprietarioMes,
      }));
      const { error: erroComp } = await supabase.from('reserva_competencias').insert(linhas);
      if (erroComp) await mostrarAlerta('Reserva salva, mas houve um erro ao gravar a divisão por mês: ' + erroComp.message, { titulo: 'Atenção' });
    }

    await recalcularFechamentosFechados(datasParaChecar);
    await registrarLog({
      acao: editando ? 'editar' : 'criar',
      tabela: 'reservas',
      registroId: data.id,
      descricao: `Reserva de ${payload.hospede} em ${dataEntrada} a ${dataSaida}`,
    });
    await mostrarAlerta(editando ? 'Reserva atualizada com sucesso.' : 'Reserva salva com sucesso.', { titulo: 'Pronto' });
    reservaEditandoId = null;
    reservaEditandoDatasOriginais = null;
    carregarReservas();
  }

  document.getElementById('btn-nova-reserva').addEventListener('click', abrirModalNovaReserva);

  // ----------------------- Reservas diretas -----------------------
  async function carregarDiretas() {
    const { data, error } = await supabase
      .from('reservas_diretas')
      .select('id, hospede, periodo_inicio, periodo_fim, valor_contrato, valor_adiantado, status, imoveis!imovel_id(nome_referencia)')
      .order('criado_em', { ascending: false });

    if (error) { await mostrarAlerta('Erro ao carregar reservas diretas: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-diretas');
    tbody.innerHTML = '';
    document.getElementById('diretas-vazio').classList.toggle('hidden', data.length > 0);

    const rotuloStatus = { pendente: 'Pendente', ok: 'Ok', cancelado: 'Cancelado' };

    data.forEach((r) => {
      const periodo = r.periodo_inicio && r.periodo_fim ? `${fmtData(r.periodo_inicio)} – ${fmtData(r.periodo_fim)}` : '—';
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5 font-medium text-slate-800">${r.imoveis?.nome_referencia || '—'}</td>
        <td class="px-5 py-2.5 text-slate-600">${r.hospede}</td>
        <td class="px-5 py-2.5 text-slate-500">${periodo}</td>
        <td class="px-5 py-2.5 text-right">${fmtMoeda(r.valor_contrato)}</td>
        <td class="px-5 py-2.5 text-right text-slate-500">${fmtMoeda(r.valor_adiantado)}</td>
        <td class="px-5 py-2.5 text-slate-500">${rotuloStatus[r.status] || r.status}</td>
        <td class="px-5 py-2.5 text-right">${celulaAcoes(
          btnVisualizar(r.id, 'btn-visualizar-direta'),
          btnExcluir(r.id, 'btn-excluir-direta'),
        )}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-visualizar-direta').forEach((b) => b.addEventListener('click', () => visualizarDireta(b.dataset.id, data)));
    tbody.querySelectorAll('.btn-excluir-direta').forEach((b) => b.addEventListener('click', () => excluirDireta(b.dataset.id)));
  }

  function visualizarDireta(id, lista) {
    const r = lista.find((x) => x.id === id);
    if (!r) return;
    const rotuloStatus = { pendente: 'Pendente', ok: 'Ok', cancelado: 'Cancelado' };
    exibirDetalhes({
      titulo: `Reserva direta — ${r.hospede}`,
      campos: [
        { label: 'Imóvel', valor: r.imoveis?.nome_referencia },
        { label: 'Hóspede', valor: r.hospede },
        { label: 'Período início', valor: r.periodo_inicio ? fmtData(r.periodo_inicio) : null },
        { label: 'Período fim', valor: r.periodo_fim ? fmtData(r.periodo_fim) : null },
        { label: 'Valor do contrato', valor: fmtMoeda(r.valor_contrato) },
        { label: 'Valor adiantado', valor: fmtMoeda(r.valor_adiantado) },
        { label: 'Status', valor: rotuloStatus[r.status] || r.status },
      ],
    });
  }

  async function excluirDireta(id) {
    const ok = await confirmarAcao('Excluir esta reserva direta?', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;
    const { error } = await supabase.from('reservas_diretas').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    carregarDiretas();
  }

  async function abrirModalNovaDireta() {
    const corpo = document.getElementById('template-direta').content.cloneNode(true);
    abrirModal({ titulo: 'Nova reserva direta', corpoEl: corpo, largura: 'max-w-lg' });
    await preencherSelectImoveis(document.getElementById('dr-imovel'));
    document.getElementById('form-direta').addEventListener('submit', salvarDireta);
  }

  async function salvarDireta(e) {
    e.preventDefault();
    const payload = {
      imovel_id: document.getElementById('dr-imovel').value,
      hospede: document.getElementById('dr-hospede').value.trim(),
      periodo_inicio: document.getElementById('dr-inicio').value || null,
      periodo_fim: document.getElementById('dr-fim').value || null,
      valor_contrato: Number(document.getElementById('dr-valor').value || 0),
      valor_adiantado: Number(document.getElementById('dr-adiantado').value || 0),
      status: document.getElementById('dr-status').value,
    };

    const { error } = await supabase.from('reservas_diretas').insert(payload);
    if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
    carregarDiretas();
  }

  document.getElementById('btn-nova-direta').addEventListener('click', abrirModalNovaDireta);

  // ----------------------- Inicialização -----------------------
  await inicializarFiltros();
  carregarReservas();
  carregarDiretas();
</script>
</body>
</html>
