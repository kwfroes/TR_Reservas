        <a href="imoveis.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg><span>Imóveis</span></a>
        <a href="proprietarios.html" class="tr-nav-item ativo flex items-center gap-2.5 rounded-lg px-3 py-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Proprietários</span></a>
        <a href="financeiro.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2" data-perfil="gestor,administrador"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg><span>Financeiro</span></a>
        <a href="fechamento.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2" data-perfil="gestor,administrador"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/><path d="m9 14 2 2 4-4"/></svg><span>Fechamento</span></a>
        <a href="relatorios.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2" data-perfil="gestor,administrador"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="8" y1="9" x2="10" y2="9"/></svg><span>Relatórios</span></a>
        <a href="parametros.html" class="tr-nav-item flex items-center gap-2.5 rounded-lg px-3 py-2" data-perfil="gestor"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg><span>Parâmetros</span></a>
      </nav>

      <div class="px-4 py-4 border-t border-white/10">
        <p id="usuario-nome" class="text-xs text-white/70 mb-2">—</p>
        <button id="btn-sair" class="text-xs text-white/70 hover:text-white underline">Sair</button>
      </div>
    </aside>

    <main class="flex-1 p-4 sm:p-6 min-w-0">
     <div class="max-w-4xl mx-auto">

      <div class="flex items-center justify-between mb-1">
        <h1 class="text-xl font-bold text-slate-900">Proprietários</h1>
        <button id="btn-novo" class="tr-btn rounded-lg px-3 py-2 text-sm font-semibold">+ Novo proprietário</button>
      </div>
      <p class="text-sm text-slate-500 mb-6">Dados cadastrais e contas de repasse.</p>

      <section class="tr-card mb-6">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-slate-500 border-b border-slate-200">
                <th class="px-5 py-2 font-medium">Nome</th>
                <th class="px-5 py-2 font-medium">CPF/CNPJ</th>
                <th class="px-5 py-2 font-medium">Contato</th>
                <th class="px-5 py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="tbody-proprietarios"></tbody>
          </table>
          <p id="lista-vazia" class="hidden px-5 py-6 text-sm text-slate-400">Nenhum proprietário cadastrado ainda.</p>
        </div>
      </section>

     </div>
    </main>
  </div>

  <!-- Template do conteúdo do modal de edição (clonado a cada abertura) -->
  <template id="template-edicao">
    <form id="form-proprietario" class="space-y-3 pb-4 mb-4 border-b border-slate-200">
      <input type="hidden" id="prop-id">
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Nome completo</label>
          <input id="prop-nome" type="text" required class="tr-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">CPF/CNPJ</label>
          <input id="prop-cpf" type="text" class="tr-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Telefone</label>
          <input id="prop-telefone" type="text" class="tr-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">E-mail</label>
          <input id="prop-email" type="email" class="tr-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
      </div>
      <div class="flex justify-end pt-1">
        <button type="submit" class="tr-btn rounded-lg px-4 py-2 text-sm font-semibold">Salvar dados</button>
      </div>
    </form>

    <div id="bloco-contas" data-perfil="gestor,administrador">
      <h3 class="text-sm font-semibold text-slate-900 mb-1">Contas bancárias</h3>
      <p id="aviso-salvar-antes" class="text-xs text-amber-600 mb-3">Salve os dados do proprietário antes de adicionar contas.</p>

      <div id="area-contas" class="hidden">
        <form id="form-conta" class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-3">
          <input id="conta-favorecido" type="text" placeholder="Favorecido" required
            class="tr-input col-span-2 sm:col-span-1 rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <input id="conta-tipo" type="text" placeholder="Tipo (PIX, BB...)" required
            class="tr-input rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <input id="conta-dados" type="text" placeholder="Chave PIX / agência e conta" required
            class="tr-input col-span-2 sm:col-span-2 rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <div class="flex gap-2">
            <button type="submit" id="conta-btn-salvar" class="tr-btn flex-1 rounded-lg px-3 py-2 text-sm font-semibold">+ Conta</button>
            <button type="button" id="conta-btn-cancelar" class="hidden rounded-lg px-3 py-2 text-sm font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">Cancelar</button>
          </div>
        </form>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-slate-500 border-b border-slate-200">
                <th class="py-2 font-medium">Favorecido</th>
                <th class="py-2 font-medium">Tipo</th>
                <th class="py-2 font-medium">Dados</th>
                <th class="py-2 font-medium">Padrão</th>
                <th class="py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="tbody-contas"></tbody>
          </table>
        </div>
      </div>
    </div>
  </template>

<script type="module">
  import { exigirSessao, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { abrirModal, fecharModal, mostrarAlerta, confirmarAcao, exibirDetalhes } from '../assets/js/modal.js';
  import { registrarLog } from '../assets/js/log.js';
  import { celulaAcoes, btnVisualizar, btnEditar, btnExcluir } from '../assets/js/icones.js';

  initSidebarMobile();

  const { nome, perfil } = await exigirSessao();
  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  let proprietarioAtualId = null;

  // ----------------------- Lista de proprietários -----------------------
  async function carregarLista() {
    const { data, error } = await supabase.from('proprietarios').select('*').order('nome');
    if (error) { await mostrarAlerta('Erro ao carregar: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-proprietarios');
    tbody.innerHTML = '';
    document.getElementById('lista-vazia').classList.toggle('hidden', data.length > 0);

    data.forEach((p) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5 font-medium text-slate-800">${p.nome}</td>
        <td class="px-5 py-2.5 text-slate-500">${p.cpf_cnpj || '—'}</td>
        <td class="px-5 py-2.5 text-slate-500">${p.telefone || p.email || '—'}</td>
        <td class="px-5 py-2.5 text-right">${celulaAcoes(
          btnVisualizar(p.id, 'btn-visualizar'),
          btnEditar(p.id, 'btn-editar'),
          btnExcluir(p.id, 'btn-excluir'),
        )}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-visualizar').forEach((b) => b.addEventListener('click', () => abrirEdicao(b.dataset.id, true)));
    tbody.querySelectorAll('.btn-editar').forEach((b) => b.addEventListener('click', () => abrirEdicao(b.dataset.id, false)));
    tbody.querySelectorAll('.btn-excluir').forEach((b) => b.addEventListener('click', () => excluirProprietario(b.dataset.id)));
  }

  async function excluirProprietario(id) {
    const ok = await confirmarAcao('Excluir este proprietário? Só é possível se não houver imóveis ou contas vinculados a ele.', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;
    const { data: prop } = await supabase.from('proprietarios').select('nome').eq('id', id).single();
    const { error } = await supabase.from('proprietarios').delete().eq('id', id);
    if (error) { await mostrarAlerta('Não foi possível excluir: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'proprietarios', registroId: id, descricao: `Proprietário "${prop?.nome || id}"` });
    carregarLista();
  }

  // ----------------------- Modal de edição -----------------------
  function montarCorpoModal() {
    const template = document.getElementById('template-edicao');
    return template.content.cloneNode(true);
  }

  function ligarEventosDoModal() {
    aplicarVisibilidadePorPerfil(perfil); // o bloco de contas tem data-perfil; precisa reavaliar após inserir no DOM
    contaEditandoId = null; // o modal é recriado do zero a cada abertura
    document.getElementById('form-proprietario').addEventListener('submit', salvarProprietario);
    document.getElementById('form-conta').addEventListener('submit', salvarConta);
    document.getElementById('conta-btn-cancelar').addEventListener('click', cancelarEdicaoConta);
  }

  function abrirPainelNovo() {
    proprietarioAtualId = null;
    const corpo = montarCorpoModal();
    abrirModal({ titulo: 'Novo proprietário', corpoEl: corpo, largura: 'max-w-lg' });
    ligarEventosDoModal();
    document.getElementById('aviso-salvar-antes').classList.remove('hidden');
    document.getElementById('prop-nome').focus();
  }

  async function abrirEdicao(id, somenteLeitura = false) {
    const { data, error } = await supabase.from('proprietarios').select('*').eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    proprietarioAtualId = id;
    const corpo = montarCorpoModal();
    abrirModal({ titulo: `${somenteLeitura ? 'Visualizar' : 'Editar'} — ${data.nome}`, corpoEl: corpo, largura: 'max-w-lg' });
    ligarEventosDoModal();

    document.getElementById('prop-id').value = data.id;
    document.getElementById('prop-nome').value = data.nome || '';
    document.getElementById('prop-cpf').value = data.cpf_cnpj || '';
    document.getElementById('prop-telefone').value = data.telefone || '';
    document.getElementById('prop-email').value = data.email || '';

    document.getElementById('aviso-salvar-antes').classList.add('hidden');
    document.getElementById('area-contas').classList.remove('hidden');
    carregarContas(id, somenteLeitura);

    if (somenteLeitura) bloquearParaLeitura();
  }

  /** Desabilita todos os campos do modal aberto e esconde o botão de salvar
   * e o formulário de nova conta — usado pelo botão "Visualizar". */
  function bloquearParaLeitura() {
    document.querySelectorAll('#modal-corpo input, #modal-corpo select, #modal-corpo textarea').forEach((el) => { el.disabled = true; });
    const btnSalvar = document.querySelector('#form-proprietario button[type="submit"]');
    if (btnSalvar) btnSalvar.classList.add('hidden');
    const formConta = document.getElementById('form-conta');
    if (formConta) formConta.classList.add('hidden');
  }

  document.getElementById('btn-novo').addEventListener('click', abrirPainelNovo);

  async function salvarProprietario(e) {
    e.preventDefault();
    const payload = {
      nome: document.getElementById('prop-nome').value.trim(),
      cpf_cnpj: document.getElementById('prop-cpf').value.trim() || null,
      telefone: document.getElementById('prop-telefone').value.trim() || null,
      email: document.getElementById('prop-email').value.trim() || null,
    };

    if (proprietarioAtualId) {
      const { error } = await supabase.from('proprietarios').update(payload).eq('id', proprietarioAtualId);
      if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
      await registrarLog({ acao: 'editar', tabela: 'proprietarios', registroId: proprietarioAtualId, descricao: `Proprietário "${payload.nome}"` });
    } else {
      const { data, error } = await supabase.from('proprietarios').insert(payload).select().single();
      if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }
      proprietarioAtualId = data.id;
      document.getElementById('modal-titulo').textContent = `Editar — ${data.nome}`;
      document.getElementById('aviso-salvar-antes').classList.add('hidden');
      document.getElementById('area-contas').classList.remove('hidden');
      carregarContas(proprietarioAtualId);
      await registrarLog({ acao: 'criar', tabela: 'proprietarios', registroId: data.id, descricao: `Proprietário "${payload.nome}"` });
    }
    carregarLista();
  }

  // ----------------------- Contas bancárias -----------------------
  async function carregarContas(proprietarioId, somenteLeitura = false) {
    const { data, error } = await supabase
      .from('contas_bancarias')
      .select('*')
      .eq('proprietario_id', proprietarioId)
      .order('padrao', { ascending: false });

    if (error) { await mostrarAlerta('Erro ao carregar contas: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-contas');
    if (!tbody) return; // modal pode já ter sido fechado
    tbody.innerHTML = '';
    data.forEach((c) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      const statusPadrao = c.padrao
        ? '<span class="text-xs text-green-700 bg-green-50 rounded px-2 py-0.5">padrão</span>'
        : somenteLeitura
          ? '<span class="text-xs text-slate-400">—</span>'
          : `<button data-id="${c.id}" class="btn-tornar-padrao text-xs text-blue-600 hover:underline">tornar padrão</button>`;
      const acoes = somenteLeitura ? '' : `
          <button data-id="${c.id}" data-favorecido="${c.favorecido}" data-tipo="${c.tipo}" data-dados="${c.dados_bancarios}"
            class="btn-editar-conta text-xs text-blue-600 hover:underline mr-3">Editar</button>
          <button data-id="${c.id}" class="btn-excluir-conta text-xs text-red-600 hover:underline">Remover</button>`;
      tr.innerHTML = `
        <td class="py-2">${c.favorecido}</td>
        <td class="py-2 text-slate-500">${c.tipo}</td>
        <td class="py-2 text-slate-500">${c.dados_bancarios}</td>
        <td class="py-2">${statusPadrao}</td>
        <td class="py-2 text-right">${acoes}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-tornar-padrao').forEach((b) => b.addEventListener('click', () => tornarPadrao(b.dataset.id, proprietarioId)));
    tbody.querySelectorAll('.btn-editar-conta').forEach((b) => b.addEventListener('click', () => iniciarEdicaoConta(b.dataset)));
    tbody.querySelectorAll('.btn-excluir-conta').forEach((b) => b.addEventListener('click', () => excluirConta(b.dataset.id, proprietarioId)));
  }

  let contaEditandoId = null;

  function cancelarEdicaoConta() {
    contaEditandoId = null;
    const form = document.getElementById('form-conta');
    if (form) form.reset();
    document.getElementById('conta-btn-salvar').textContent = '+ Conta';
    document.getElementById('conta-btn-cancelar').classList.add('hidden');
  }

  function iniciarEdicaoConta(dataset) {
    contaEditandoId = dataset.id;
    document.getElementById('conta-favorecido').value = dataset.favorecido;
    document.getElementById('conta-tipo').value = dataset.tipo;
    document.getElementById('conta-dados').value = dataset.dados;
    document.getElementById('conta-btn-salvar').textContent = 'Salvar alterações';
    document.getElementById('conta-btn-cancelar').classList.remove('hidden');
  }

  async function salvarConta(e) {
    e.preventDefault();
    if (!proprietarioAtualId) return;

    const payload = {
      favorecido: document.getElementById('conta-favorecido').value.trim(),
      tipo: document.getElementById('conta-tipo').value.trim(),
      dados_bancarios: document.getElementById('conta-dados').value.trim(),
    };

    const editandoConta = !!contaEditandoId;
    const { data: salvo, error } = editandoConta
      ? await supabase.from('contas_bancarias').update(payload).eq('id', contaEditandoId).select().single()
      : await supabase.from('contas_bancarias').insert({ ...payload, proprietario_id: proprietarioAtualId, padrao: false }).select().single();

    if (error) { await mostrarAlerta('Erro ao salvar conta: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({
      acao: editandoConta ? 'editar' : 'criar', tabela: 'contas_bancarias', registroId: salvo.id,
      descricao: `Conta de ${payload.favorecido} (${payload.tipo})`,
    });
    cancelarEdicaoConta();
    carregarContas(proprietarioAtualId);
  }

  async function tornarPadrao(contaId, proprietarioId) {
    await supabase.from('contas_bancarias').update({ padrao: false }).eq('proprietario_id', proprietarioId);
    const { error } = await supabase.from('contas_bancarias').update({ padrao: true }).eq('id', contaId);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'editar', tabela: 'contas_bancarias', registroId: contaId, descricao: 'Conta marcada como padrão' });
    carregarContas(proprietarioId);
  }

  async function excluirConta(contaId, proprietarioId) {
    const ok = await confirmarAcao('Remover esta conta bancária?', { perigo: true, textoConfirmar: 'Remover' });
    if (!ok) return;
    const { error } = await supabase.from('contas_bancarias').delete().eq('id', contaId);
    if (error) { await mostrarAlerta('Não foi possível remover: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'contas_bancarias', registroId: contaId, descricao: 'Conta bancária removida' });
    carregarContas(proprietarioId);
  }

  carregarLista();
</script>
</body>
</html>
</file>

<file path="app/reservas.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Reservas — TR Serviços de Reservas</title>
<link rel="icon" type="image/svg+xml" href="../assets/img/logo.svg">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/css/theme.css">
</head>
<body class="min-h-screen bg-slate-50">

  <div class="flex flex-col sm:flex-row min-h-screen">

    <header class="sm:hidden flex items-center justify-between px-4 py-3 tr-bg-azul text-white sticky top-0 z-20">
      <button id="btn-menu-abrir" aria-label="Abrir menu" aria-expanded="false" class="p-1 -ml-1">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </button>
      <div class="flex items-center gap-2">
        <div class="tr-logo-ring rounded-md w-7 h-7 flex items-center justify-center">
          <span class="text-xs font-extrabold"><span style="color: var(--tr-verde)">T</span><span class="text-white">R</span></span>
        </div>
        <span class="text-sm font-semibold">TR Reservas</span>
      </div>
      <span class="w-6" aria-hidden="true"></span>
    </header>

    <div id="sidebar-overlay" class="hidden sm:hidden fixed inset-0 bg-black/40 z-30"></div>

    <aside id="sidebar"
      class="fixed sm:static inset-y-0 left-0 z-40 w-64 sm:w-56 shrink-0 tr-bg-azul text-white flex flex-col -translate-x-full sm:translate-x-0 transition-transform duration-200">
