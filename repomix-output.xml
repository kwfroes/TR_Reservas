<script type="module">
  import { exigirSessao, exigirPerfil, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { mostrarAlerta, confirmarAcao, exibirDetalhes } from '../assets/js/modal.js';
  import { ratearDespesa, confirmarSeMesFechado, recalcularFechamentosFechados, sincronizarRepassesDoMes } from '../assets/js/calculo.js';
  import { registrarLog } from '../assets/js/log.js';
  import { celulaAcoes, btnVisualizar, btnEditar, btnExcluir } from '../assets/js/icones.js';

  initSidebarMobile();

  const { nome, perfil } = await exigirSessao();
  exigirPerfil(perfil, ['gestor', 'administrador']); // dupla garantia — RLS de `repasses` já bloqueia operador no banco

  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  // ----------------------- Abas -----------------------
  function ativarAba(tabId) {
    document.querySelectorAll('.tr-tab-btn').forEach((b) => b.classList.toggle('ativo', b.dataset.tab === tabId));
    document.querySelectorAll('[data-painel]').forEach((p) => p.classList.toggle('hidden', p.dataset.painel !== tabId));
  }
  document.querySelectorAll('.tr-tab-btn').forEach((b) => b.addEventListener('click', () => ativarAba(b.dataset.tab)));

  const fmtMoeda = (v) => (v ?? 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const fmtData = (iso) => new Date(iso + 'T00:00:00').toLocaleDateString('pt-BR');
  const hoje = () => new Date().toISOString().slice(0, 10);
  const mesAtual = () => new Date().toISOString().slice(0, 7);

  let imoveisCache = [];
  async function carregarImoveis() {
    if (imoveisCache.length) return imoveisCache;
    const { data, error } = await supabase.from('imoveis').select('id, nome_referencia, codigo_interno').order('nome_referencia');
    if (error) { await mostrarAlerta('Erro ao carregar imóveis: ' + error.message, { titulo: 'Erro' }); return []; }
    imoveisCache = data;
    return data;
  }

  async function preencherSelectsImoveis() {
    const imoveis = await carregarImoveis();
    document.querySelectorAll('.select-imovel').forEach((select) => {
      select.innerHTML = '<option value="">Selecione...</option>';
      imoveis.forEach((im) => {
        const opt = document.createElement('option');
        opt.value = im.id;
        opt.textContent = `${im.nome_referencia} (${im.codigo_interno})`;
        select.appendChild(opt);
      });
    });
  }
  document.getElementById('mn-imovel').classList.add('select-imovel');

  // ======================================================================
  // REPASSES
  // ======================================================================
  function inicioFimDoMes(mesStr) {
    const [ano, mes] = mesStr.split('-').map(Number);
    const inicio = `${mesStr}-01`;
    const fim = mes === 12 ? `${ano + 1}-01-01` : `${ano}-${String(mes + 1).padStart(2, '0')}-01`;
    return { inicio, fim };
  }

  async function carregarRepasses() {
    const mes = document.getElementById('repasse-mes').value;
    if (!mes) return;
    const { inicio } = inicioFimDoMes(mes);

    try {
      await sincronizarRepassesDoMes(inicio); // recalcula os pendentes antes de exibir
    } catch (err) {
      await mostrarAlerta('Erro ao atualizar repasses: ' + err.message, { titulo: 'Erro' });
    }

    const { data, error } = await supabase
      .from('repasses')
      .select('*, imoveis!imovel_id(nome_referencia)')
      .eq('mes_referencia', inicio)
      .order('valor_bruto', { ascending: false });

    if (error) { await mostrarAlerta('Erro ao carregar repasses: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-repasses');
    tbody.innerHTML = '';
    document.getElementById('repasses-vazio').classList.toggle('hidden', data.length > 0);

    data.forEach((r) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-5 py-2.5 font-medium text-slate-800">${r.imoveis?.nome_referencia || '—'}</td>
