    await registrarLog({
      acao: editandoPagamento ? 'editar' : 'criar', tabela: 'pagamentos_pessoal', registroId: salvo.id,
      descricao: `Pagamento de ${fmtMoeda(payload.valor)} a ${payload.funcionario} (${payload.data})`,
    });
    cancelarEdicaoPagamento();
    carregarPagamentos();
  });

  async function excluirPagamento(id) {
    const ok = await confirmarAcao('Excluir este pagamento?', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;
    const { data: pagamento, error: erroBusca } = await supabase
      .from('pagamentos_pessoal').select('funcionario, valor, data').eq('id', id).single();
    if (erroBusca) { await mostrarAlerta('Erro: ' + erroBusca.message, { titulo: 'Erro' }); return; }
    const { error } = await supabase.from('pagamentos_pessoal').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({
      acao: 'excluir', tabela: 'pagamentos_pessoal', registroId: id,
      descricao: `Pagamento de ${fmtMoeda(pagamento.valor)} a ${pagamento.funcionario} (${pagamento.data})`,
    });
    carregarPagamentos();
  }

  // ======================================================================
  // ESTOQUE
  // ======================================================================
  async function carregarEstoque() {
    const { data, error } = await supabase.from('estoque').select('*').order('data_compra', { ascending: false }).limit(100);
    if (error) { await mostrarAlerta('Erro ao carregar estoque: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-estoque');
    tbody.innerHTML = '';
    document.getElementById('estoque-vazio').classList.toggle('hidden', data.length > 0);

    data.forEach((it) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-4 py-2.5 text-slate-500">${fmtData(it.data_compra)}</td>
        <td class="px-4 py-2.5 font-medium text-slate-800">${it.item}</td>
        <td class="px-4 py-2.5 text-right text-slate-500">${it.quantidade}</td>
        <td class="px-4 py-2.5 text-right">${it.quantidade_atual}</td>
        <td class="px-4 py-2.5 text-right text-slate-500">${it.valor_unitario != null ? fmtMoeda(it.valor_unitario) : '—'}</td>
        <td class="px-4 py-2.5 text-right">${celulaAcoes(
          btnVisualizar(it.id, 'btn-visualizar-estoque'),
          btnEditar(it.id, 'btn-editar-estoque'),
          btnExcluir(it.id, 'btn-excluir-estoque'),
        )}</td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-visualizar-estoque').forEach((b) => b.addEventListener('click', () => visualizarEstoque(b.dataset.id, data)));
    tbody.querySelectorAll('.btn-editar-estoque').forEach((b) => b.addEventListener('click', () => iniciarEdicaoEstoque(b.dataset.id)));
    tbody.querySelectorAll('.btn-excluir-estoque').forEach((b) => b.addEventListener('click', () => excluirEstoque(b.dataset.id)));
  }

  function visualizarEstoque(id, lista) {
    const it = lista.find((x) => x.id === id);
    if (!it) return;
    exibirDetalhes({
      titulo: `Estoque — ${it.item}`,
      campos: [
        { label: 'Data da compra', valor: fmtData(it.data_compra) },
        { label: 'Item', valor: it.item },
        { label: 'Quantidade comprada', valor: it.quantidade },
        { label: 'Quantidade atual', valor: it.quantidade_atual },
        { label: 'Valor unitário', valor: it.valor_unitario != null ? fmtMoeda(it.valor_unitario) : null },
      ],
    });
  }

  let estoqueEditandoId = null;

  function cancelarEdicaoEstoque() {
    estoqueEditandoId = null;
    document.getElementById('form-estoque').reset();
    document.getElementById('es-btn-salvar').textContent = 'Adicionar';
    document.getElementById('es-btn-cancelar').classList.add('hidden');
  }

  async function iniciarEdicaoEstoque(id) {
    const { data: it, error } = await supabase.from('estoque').select('*').eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    estoqueEditandoId = id;
    document.getElementById('es-data').value = it.data_compra;
    document.getElementById('es-item').value = it.item;
    document.getElementById('es-quantidade').value = it.quantidade;
    document.getElementById('es-quantidade-atual').value = it.quantidade_atual;
    document.getElementById('es-valor-unitario').value = it.valor_unitario ?? '';
    document.getElementById('es-btn-salvar').textContent = 'Salvar alterações';
    document.getElementById('es-btn-cancelar').classList.remove('hidden');
  }

  document.getElementById('es-btn-cancelar').addEventListener('click', cancelarEdicaoEstoque);

  document.getElementById('form-estoque').addEventListener('submit', async (e) => {
    e.preventDefault();
    const editando = !!estoqueEditandoId;
    const payload = {
      data_compra: document.getElementById('es-data').value,
      item: document.getElementById('es-item').value.trim(),
      quantidade: Number(document.getElementById('es-quantidade').value || 0),
      quantidade_atual: Number(document.getElementById('es-quantidade-atual').value || 0),
      valor_unitario: document.getElementById('es-valor-unitario').value ? Number(document.getElementById('es-valor-unitario').value) : null,
    };

    const { data: salvo, error } = editando
      ? await supabase.from('estoque').update(payload).eq('id', estoqueEditandoId).select().single()
      : await supabase.from('estoque').insert(payload).select().single();
    if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }

    await registrarLog({
      acao: editando ? 'editar' : 'criar', tabela: 'estoque', registroId: salvo.id,
      descricao: `Estoque "${payload.item}" — qtd. atual ${payload.quantidade_atual}`,
    });
    cancelarEdicaoEstoque();
    carregarEstoque();
  });

  async function excluirEstoque(id) {
    const ok = await confirmarAcao('Excluir este item do estoque?', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;
    const { data: item, error: erroBusca } = await supabase.from('estoque').select('item').eq('id', id).single();
    if (erroBusca) { await mostrarAlerta('Erro: ' + erroBusca.message, { titulo: 'Erro' }); return; }
    const { error } = await supabase.from('estoque').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    await registrarLog({ acao: 'excluir', tabela: 'estoque', registroId: id, descricao: `Estoque "${item.item}"` });
    carregarEstoque();
  }

  // ======================================================================
  // LOGS (histórico de criar/editar/excluir)
  // ======================================================================
  const ROTULO_ACAO = { criar: 'Criou', editar: 'Editou', excluir: 'Excluiu' };

  async function carregarLogs() {
    const { data, error } = await supabase
      .from('logs_atividade')
      .select('criado_em, acao, tabela, descricao, usuarios(nome)')
      .order('criado_em', { ascending: false })
      .limit(200);
    if (error) { await mostrarAlerta('Erro ao carregar logs: ' + error.message, { titulo: 'Erro' }); return; }

    const tbody = document.getElementById('tbody-logs');
    tbody.innerHTML = '';
    document.getElementById('logs-vazio').classList.toggle('hidden', data.length > 0);

    data.forEach((l) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 tr-row';
      tr.innerHTML = `
        <td class="px-4 py-2.5 text-slate-500 whitespace-nowrap">${new Date(l.criado_em).toLocaleString('pt-BR')}</td>
        <td class="px-4 py-2.5 text-slate-700">${l.usuarios?.nome || '—'}</td>
        <td class="px-4 py-2.5 text-slate-500">${ROTULO_ACAO[l.acao] || l.acao}</td>
        <td class="px-4 py-2.5 text-slate-500">${l.tabela}</td>
        <td class="px-4 py-2.5 text-slate-700">${l.descricao || '—'}</td>`;
      tbody.appendChild(tr);
    });
  }

  document.querySelector('[data-tab="logs"]').addEventListener('click', carregarLogs);

  // ======================================================================
  // Inicialização
  // ======================================================================
  document.getElementById('repasse-mes').value = mesAtual();
  document.getElementById('mn-data').value = hoje();
  document.getElementById('ds-data').value = hoje();
  document.getElementById('pg-data').value = hoje();
  document.getElementById('es-data').value = hoje();

  await preencherSelectsImoveis();
  carregarRepasses();
  carregarManutencoes();
  carregarDespesas();
  carregarPagamentos();
  carregarEstoque();
</script>
</body>
</html>
</file>

