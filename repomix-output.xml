  let manutencaoEditandoId = null;
  let manutencaoEditandoAntiga = null; // { data, cobrado_proprietario } — só quando editando

  function cancelarEdicaoManutencao() {
    manutencaoEditandoId = null;
    manutencaoEditandoAntiga = null;
    document.getElementById('form-manutencao').reset();
    document.getElementById('mn-btn-salvar').textContent = 'Adicionar';
    document.getElementById('mn-btn-cancelar').classList.add('hidden');
  }

  async function iniciarEdicaoManutencao(id) {
    const { data: m, error } = await supabase.from('manutencoes').select('*').eq('id', id).single();
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    manutencaoEditandoId = id;
    manutencaoEditandoAntiga = { data: m.data, cobrado_proprietario: m.cobrado_proprietario };
    document.getElementById('mn-imovel').value = m.imovel_id;
    document.getElementById('mn-data').value = m.data;
    document.getElementById('mn-servico').value = m.servico;
    document.getElementById('mn-valor').value = m.valor ?? '';
    document.getElementById('mn-cobrado').checked = m.cobrado_proprietario;
    document.getElementById('mn-btn-salvar').textContent = 'Salvar alterações';
    document.getElementById('mn-btn-cancelar').classList.remove('hidden');
    document.getElementById('mn-data').scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  document.getElementById('mn-btn-cancelar').addEventListener('click', cancelarEdicaoManutencao);

  document.getElementById('form-manutencao').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = document.getElementById('mn-data').value;
    const cobradoProprietario = document.getElementById('mn-cobrado').checked;
    const editando = !!manutencaoEditandoId;

    // Só a manutenção paga pela própria TR entra no fechamento mensal (a
    // cobrada do proprietário é descontada do repasse dele, não é despesa da TR).
    // Editando, tanto o estado antigo quanto o novo podem afetar um fechamento.
    const datasParaChecar = [];
    if (!cobradoProprietario) datasParaChecar.push(data);
    if (editando && !manutencaoEditandoAntiga.cobrado_proprietario) datasParaChecar.push(manutencaoEditandoAntiga.data);
    if (datasParaChecar.length) {
      const podeProsseguir = await confirmarSeMesFechado(datasParaChecar, confirmarAcao);
      if (!podeProsseguir) return;
    }

    const payload = {
      imovel_id: document.getElementById('mn-imovel').value,
      data,
      servico: document.getElementById('mn-servico').value.trim(),
      valor: document.getElementById('mn-valor').value ? Number(document.getElementById('mn-valor').value) : null,
      cobrado_proprietario: cobradoProprietario,
    };

    const { data: salvo, error } = editando
      ? await supabase.from('manutencoes').update(payload).eq('id', manutencaoEditandoId).select().single()
      : await supabase.from('manutencoes').insert({ ...payload, status: 'pendente' }).select().single();
    if (error) { await mostrarAlerta('Erro ao salvar: ' + error.message, { titulo: 'Erro' }); return; }

    if (datasParaChecar.length) await recalcularFechamentosFechados(datasParaChecar);
    await registrarLog({
      acao: editando ? 'editar' : 'criar', tabela: 'manutencoes', registroId: salvo.id,
      descricao: `Manutenção "${payload.servico}" em ${data}${cobradoProprietario ? ' (cobrado do proprietário)' : ''}`,
    });
    cancelarEdicaoManutencao();
    carregarManutencoes();
    carregarRepasses();
  });

  async function concluirManutencao(id) {
    const { error } = await supabase.from('manutencoes').update({ status: 'ok' }).eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }
    carregarManutencoes();
    carregarRepasses();
  }

  async function excluirManutencao(id) {
    const ok = await confirmarAcao('Excluir esta manutenção?', { perigo: true, textoConfirmar: 'Excluir' });
    if (!ok) return;

    const { data: manutencao, error: erroBusca } = await supabase
      .from('manutencoes').select('data, servico, cobrado_proprietario').eq('id', id).single();
    if (erroBusca) { await mostrarAlerta('Erro: ' + erroBusca.message, { titulo: 'Erro' }); return; }

    if (!manutencao.cobrado_proprietario) {
      const podeProsseguir = await confirmarSeMesFechado([manutencao.data], confirmarAcao);
      if (!podeProsseguir) return;
    }

    const { error } = await supabase.from('manutencoes').delete().eq('id', id);
    if (error) { await mostrarAlerta('Erro: ' + error.message, { titulo: 'Erro' }); return; }

    if (!manutencao.cobrado_proprietario) await recalcularFechamentosFechados([manutencao.data]);
    await registrarLog({
      acao: 'excluir', tabela: 'manutencoes', registroId: id,
      descricao: `Manutenção "${manutencao.servico}" (${manutencao.data})`,
    });
    carregarManutencoes();
    carregarRepasses();
  }

