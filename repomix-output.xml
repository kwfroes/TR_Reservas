<script type="module">
  import { exigirSessao, exigirPerfil, sair, aplicarVisibilidadePorPerfil } from '../assets/js/auth-guard.js';
  import { initSidebarMobile } from '../assets/js/sidebar.js';
  import { supabase } from '../assets/js/supabaseClient.js';
  import { mostrarAlerta } from '../assets/js/modal.js';
  // import { jsPDF } from 'https://cdn.jsdelivr.net/npm/jspdf@2.5.1/+esm';
  // import autoTable from 'https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.3/+esm';
  const { jsPDF } = window.jspdf;

  initSidebarMobile();

  const { nome, perfil } = await exigirSessao();
  exigirPerfil(perfil, ['gestor', 'administrador']);

  document.getElementById('usuario-nome').textContent = `${nome} · ${perfil}`;
  aplicarVisibilidadePorPerfil(perfil);
  document.getElementById('btn-sair').addEventListener('click', sair);

  const fmtMoeda = (v) => (v ?? 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const fmtData = (iso) => new Date(iso + 'T00:00:00').toLocaleDateString('pt-BR');
  const NOMES_MES = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];

  function limitesDoMes(ano, mesIndice /* 0-11 */) {
    const inicio = `${ano}-${String(mesIndice + 1).padStart(2, '0')}-01`;
    const fimAno = mesIndice === 11 ? ano + 1 : ano;
    const fimMes = mesIndice === 11 ? 1 : mesIndice + 2;
    const fim = `${fimAno}-${String(fimMes).padStart(2, '0')}-01`;
    return { inicio, fim };
  }

  function noitesEntre(a, b) {
    return Math.round((new Date(b + 'T00:00:00') - new Date(a + 'T00:00:00')) / 86400000);
  }

  // ----------------------- Seleção de imóvel / tipo -----------------------
  async function carregarImoveis() {
    const { data, error } = await supabase.from('imoveis').select('id, nome_referencia, codigo_interno').order('nome_referencia');
    if (error) { await mostrarAlerta('Erro ao carregar imóveis: ' + error.message, { titulo: 'Erro' }); return; }
    const select = document.getElementById('rl-imovel');
    select.innerHTML = '<option value="">Selecione...</option>';
    data.forEach((im) => {
      const opt = document.createElement('option');
      opt.value = im.id;
      opt.textContent = `${im.nome_referencia} (${im.codigo_interno})`;
      select.appendChild(opt);
    });
  }

  document.querySelectorAll('input[name="rl-tipo"]').forEach((r) => {
    r.addEventListener('change', () => {
      const mensal = document.querySelector('input[name="rl-tipo"]:checked').value === 'mensal';
      document.getElementById('campo-mes').classList.toggle('hidden', !mensal);
      document.getElementById('campo-ano').classList.toggle('hidden', mensal);
      document.getElementById('campo-observacoes').classList.toggle('hidden', !mensal);
    });
  });

  // ----------------------- Dados: um mês de um imóvel -----------------------
  // Agrupa pelo mês de CHECK-IN (como um extrato) — propositalmente diferente
  // do Fechamento Mensal, que usa a divisão de competência para a contabilidade
  // da empresa como um todo. Pequenas diferenças numa reserva que atravessa
  // virada de mês são esperadas entre os dois relatórios.
  async function dadosDoMes(imovelId, ano, mesIndice) {
    const { inicio, fim } = limitesDoMes(ano, mesIndice);

    const { data: reservas, error } = await supabase
      .from('reservas')
      .select('hospede, data_entrada, data_saida, valor_bruto, valor_limpeza, valor_comissao, valor_proprietario, numero_nf')
      .eq('imovel_id', imovelId)
      .gte('data_entrada', inicio)
      .lt('data_entrada', fim)
      .order('data_entrada');
    if (error) throw error;

    const { data: manutencoes, error: erroManut } = await supabase
      .from('manutencoes')
      .select('data, servico, valor')
      .eq('imovel_id', imovelId)
      .eq('cobrado_proprietario', true)
      .gte('data', inicio)
      .lt('data', fim);
    if (erroManut) throw erroManut;

    // Ocupação: noites realmente ocupadas no mês, de qualquer reserva que o
    // toque (overlap), não só as que começaram nele.
    const { data: reservasOverlap, error: erroOverlap } = await supabase
      .from('reservas').select('data_entrada, data_saida').eq('imovel_id', imovelId).lt('data_entrada', fim).gt('data_saida', inicio);
    if (erroOverlap) throw erroOverlap;

    const inicioData = new Date(inicio + 'T00:00:00');
    const fimData = new Date(fim + 'T00:00:00');
    const diasNoMes = Math.round((fimData - inicioData) / 86400000);
    let noitesOcupadas = 0;
    reservasOverlap.forEach((r) => {
      const entrada = new Date(r.data_entrada + 'T00:00:00');
      const saida = new Date(r.data_saida + 'T00:00:00');
      const ini = entrada < inicioData ? inicioData : entrada;
      const fimR = saida > fimData ? fimData : saida;
      noitesOcupadas += Math.max(0, Math.round((fimR - ini) / 86400000));
    });

    const totalDiarias = reservas.reduce((s, r) => s + noitesEntre(r.data_entrada, r.data_saida), 0);
    const valorBrutoTotal = reservas.reduce((s, r) => s + Number(r.valor_bruto || 0), 0);
    const totalLimpeza = reservas.reduce((s, r) => s + Number(r.valor_limpeza || 0), 0);
    const totalComissao = reservas.reduce((s, r) => s + Number(r.valor_comissao || 0), 0);
    const somaProprietario = reservas.reduce((s, r) => s + Number(r.valor_proprietario || 0), 0);
    const totalDeducoes = manutencoes.reduce((s, m) => s + Number(m.valor || 0), 0);
    const mediaDiaria = totalDiarias > 0 ? (valorBrutoTotal - totalLimpeza) / totalDiarias : 0;

    return {
      reservas, manutencoes,
      totalReservas: reservas.length, totalDiarias, valorBrutoTotal, mediaDiaria,
      totalLimpeza, totalComissao, totalDeducoes,
      valorLiquidoRepassado: somaProprietario - totalDeducoes,
      taxaOcupacao: diasNoMes > 0 ? noitesOcupadas / diasNoMes : 0,
    };
  }

  // ----------------------- Desenho do PDF -----------------------
  function desenharCabecalho(doc, { subtitulo, imovelNome, proprietarioNome, periodoTexto }) {
    // 1. Fundo cinza claro da faixa (Banner)
    const bannerY = 10, bannerH = 36;
    doc.setFillColor(235, 237, 240);
    doc.rect(14, bannerY, 182, bannerH, 'F');

    // ===== LOGO – geometria paramétrica =====
    const pad = 2;           // borda azul ao redor do box branco
    const whiteW = 26;       // largura do box branco
    const whiteH = 19;       // altura do box branco
    const gapTexto = 2;      // espaço entre box branco e "BRAZIL HOST"
    const capHost = 5.5 * 0.3528 * 0.72; // altura das maiúsculas do "BRAZIL HOST" (mm)

    const logoW = whiteW + pad * 2;
    const logoH = pad + whiteH + gapTexto + capHost + pad;
    const logoX = 14 + 3;                          // pequena margem à esquerda (use 14 para encostar)
    const logoY = bannerY + (bannerH - logoH) / 2; // centralizado verticalmente na faixa

    // 2. Bloco Azul da Logo
    doc.setFillColor(0, 74, 173); // #004AAD
    doc.roundedRect(logoX, logoY, logoW, logoH, 3.5, 3.5, 'F');

    // 3. Borda branca interna da Logo
    const boxX = logoX + pad, boxY = logoY + pad;
    doc.setDrawColor(255, 255, 255);
    doc.setLineWidth(0.6);
    doc.roundedRect(boxX, boxY, whiteW, whiteH, 2.5, 2.5, 'S');

    // 4. Letras T R – centralizadas no box branco
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(26);
    const centroX = boxX + whiteW / 2;
    const centroY = boxY + whiteH / 2;
    const gapTR = 0.6; // espaço entre T e R – ajuste fino aqui
    const wT = doc.getTextWidth('T');
    const wR = doc.getTextWidth('R');
    const xInicio = centroX - (wT + gapTR + wR) / 2;
    const baseline = centroY + (26 * 0.3528 * 0.72) / 2;

    doc.setTextColor(126, 217, 86); // #7ED956
    doc.text('T', xInicio, baseline);
    doc.setTextColor(255, 255, 255);
    doc.text('R', xInicio + wT + gapTR, baseline);

    // 5. Texto BRAZIL HOST – logo abaixo do box branco
    doc.setFontSize(5.5);
    doc.setTextColor(255, 255, 255);
    doc.text('BRAZIL HOST', logoX + logoW / 2, boxY + whiteH + gapTexto + capHost, { align: 'center' });

    // 6. Dados da Empresa (à direita do bloco azul)
    const textX = logoX + logoW + 5;
    const maxWidth = 196 - textX - 2;

    doc.setTextColor(30, 41, 59);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.text('TR SERVIÇOS DE RESERVAS TURÍSTICAS LTDA', textX, 16.5);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8);
    doc.text('54.007.292/0001-13', textX, 21.5);

    // Endereço longo – quebra automática
    doc.setFontSize(7.2);
    const endereco = 'AVENIDA TANCREDO NEVES, 1632, EDF SALVADOR TRADE CENTER, TORRE NORTE SL 1514, CAMINHO DAS ÁRVORES';
    const linhasEndereco = doc.splitTextToSize(endereco, maxWidth);
    doc.text(linhasEndereco, textX, 26.5);

    // Cidade / CEP
    const yCidade = 26.5 + (linhasEndereco.length * 3.6);
    doc.setFontSize(8);
    doc.text('SALVADOR - BAHIA, CEP: 41.820-021', textX, yCidade);

    // Telefone + e-mail
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(8);
    doc.text('(71) 9.8876-8130 - TRBRAZILHOST@GMAIL.COM', textX, yCidade + 4.5);

    // 7. Dados Específicos do Relatório
    let y = 52;
    doc.setFontSize(11);
    doc.setTextColor(0, 74, 173);
    doc.setFont('helvetica', 'bold');
    doc.text(subtitulo, 14, y);

    y += 6;
    doc.setFontSize(9);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(71, 85, 105);

    doc.text(`Imóvel: ${imovelNome}`, 14, y);
    doc.text(`Proprietário: ${proprietarioNome}`, 105, y);

    y += 5;
    doc.text(`Período: ${periodoTexto}`, 14, y);
    doc.text(`Gerado em: ${new Date().toLocaleString('pt-BR')}`, 105, y);

    // Linha divisória
    doc.setDrawColor(226, 232, 240);
    doc.line(14, y + 3, 196, y + 3);

    return y + 8;
  }

  function desenharRodape(doc) {
    const totalPaginas = doc.getNumberOfPages();
    const pageW = doc.internal.pageSize.getWidth();   // 210
    const pageH = doc.internal.pageSize.getHeight();  // 297
    const agora = new Date();
    const emissao = `Emitido em ${agora.toLocaleDateString('pt-BR')} às ${agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })} por TR BRAZIL HOST`;

    for (let i = 1; i <= totalPaginas; i++) {
      doc.setPage(i);

      // Linha divisória
      doc.setDrawColor(226, 232, 240);
      doc.setLineWidth(0.3);
      doc.line(14, pageH - 14, pageW - 14, pageH - 14);

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(7.5);
      doc.setTextColor(100, 116, 139);

      // Esquerda: data de emissão
      doc.text(emissao, 14, pageH - 9);

      // Direita: contagem de páginas
      doc.text(`Página ${i} de ${totalPaginas}`, pageW - 14, pageH - 9, { align: 'right' });
    }
  }

  function desenharIndicadores(doc, y, indicadores) {
    doc.setFontSize(10);
    doc.setFont('helvetica', 'bold');
    doc.setTextColor(30, 41, 59);
    doc.text('Resumo do período', 14, y);
    y += 6;

    const linhas = [
      ['Nº de reservas', String(indicadores.totalReservas)],
      ['Total de diárias', `${indicadores.totalDiarias} noites`],
      ['Valor bruto total', fmtMoeda(indicadores.valorBrutoTotal)],
      ['Média de diária', fmtMoeda(indicadores.mediaDiaria)],
      ['Total de limpeza', fmtMoeda(indicadores.totalLimpeza)],
      ['Total de comissão', fmtMoeda(indicadores.totalComissao)],
      ['Deduções (manutenção)', indicadores.totalDeducoes ? '− ' + fmtMoeda(indicadores.totalDeducoes) : '—'],
      ['Valor líquido repassado', fmtMoeda(indicadores.valorLiquidoRepassado)],
    ];
    if (indicadores.taxaOcupacao != null) {
      linhas.splice(2, 0, ['Taxa de ocupação', `${(indicadores.taxaOcupacao * 100).toFixed(1)}%`]);
    }

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(71, 85, 105);
    const colLargura = 91;
    linhas.forEach((linha, i) => {
      const col = i % 2;
      const row = Math.floor(i / 2);
      const x = 14 + col * colLargura;
      const yLinha = y + row * 6;
      doc.text(`${linha[0]}:`, x, yLinha);
      doc.setFont('helvetica', 'bold');
      doc.text(linha[1], x + 45, yLinha);
      doc.setFont('helvetica', 'normal');
    });

    return y + Math.ceil(linhas.length / 2) * 6 + 6;
  }

    // ----------------------- Pré-visualização -----------------------
  let pvDoc = null, pvNome = '', pvUrl = null;
  let pvMeta = null;

  function abrirPreview(doc, nomeArquivo, meta) {
    pvDoc = doc;
    pvMeta = meta;
    pvNome = nomeArquivo;
    if (pvUrl) URL.revokeObjectURL(pvUrl);
    pvUrl = URL.createObjectURL(doc.output('blob'));
    document.getElementById('pv-iframe').src = pvUrl;
    document.getElementById('modal-preview').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function fecharPreview() {
    document.getElementById('modal-preview').classList.add('hidden');
    document.getElementById('pv-iframe').src = 'about:blank';
    document.body.style.overflow = '';
    if (pvUrl) { URL.revokeObjectURL(pvUrl); pvUrl = null; }
    pvDoc = null;
  }

  document.getElementById('pv-fechar').addEventListener('click', fecharPreview);
  document.getElementById('pv-cancelar').addEventListener('click', fecharPreview);
  document.getElementById('modal-preview').addEventListener('click', (e) => {
    if (e.target.id === 'modal-preview') fecharPreview();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !document.getElementById('modal-preview').classList.contains('hidden')) fecharPreview();
  });
  document.getElementById('pv-baixar').addEventListener('click', () => { if (pvDoc) pvDoc.save(pvNome); });

  document.getElementById('pv-email').addEventListener('click', async () => {
    if (!pvDoc || !pvMeta) return;
    const btn = document.getElementById('pv-email');
    const textoOriginal = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Enviando...';

    try {
      // jsPDF gera "data:application/pdf;filename=...;base64,XXXX" — pegamos
      // só a parte depois da vírgula, que é o base64 puro.
      const dataUri = pvDoc.output('datauristring');
      const pdfBase64 = dataUri.substring(dataUri.indexOf(',') + 1);

      const { data, error } = await supabase.functions.invoke('enviar-relatorio', {
        body: {
          imovelId: pvMeta.imovelId,
          tipo: pvMeta.tipo,
          periodoTexto: pvMeta.periodoTexto,
          nomeArquivo: pvNome,
          pdfBase64,
        },
      });

      if (error) throw error;
      if (data?.erro) throw new Error(data.erro);

      await mostrarAlerta(`Relatório enviado para ${data.destinatario}.`, { titulo: 'Enviado' });
    } catch (err) {
      await mostrarAlerta('Erro ao enviar por e-mail: ' + (err.message || err), { titulo: 'Erro' });
    } finally {
      btn.disabled = false;
      btn.textContent = textoOriginal;
    }
  });

  document.getElementById('pv-imprimir').addEventListener('click', () => {
    const frame = document.getElementById('pv-iframe');
    try { frame.contentWindow.focus(); frame.contentWindow.print(); }
    catch { window.open(pvUrl, '_blank'); } // fallback se o navegador bloquear
  });

  async function gerarPdfMensal() {
    const imovelId = document.getElementById('rl-imovel').value;
    const mesInput = document.getElementById('rl-mes').value; // 'YYYY-MM'
    if (!imovelId || !mesInput) { await mostrarAlerta('Selecione o imóvel e o mês.', { titulo: 'Campos obrigatórios' }); return; }

    const [ano, mesNum] = mesInput.split('-').map(Number);
    const mesIndice = mesNum - 1;

    const { data: imovel, error: erroImovel } = await supabase
      .from('imoveis').select('nome_referencia, proprietarios!proprietario_id(nome)').eq('id', imovelId).single();
    if (erroImovel) { await mostrarAlerta('Erro: ' + erroImovel.message, { titulo: 'Erro' }); return; }

    let dados;
    try {
      dados = await dadosDoMes(imovelId, ano, mesIndice);
    } catch (err) {
      await mostrarAlerta('Erro ao montar o relatório: ' + err.message, { titulo: 'Erro' });
      return;
    }

    const doc = new jsPDF();
    let y = desenharCabecalho(doc, {
      subtitulo: 'Relatório Mensal de Prestação de Contas',
      imovelNome: imovel.nome_referencia,
      proprietarioNome: imovel.proprietarios?.nome || '—',
      periodoTexto: `${NOMES_MES[mesIndice]}/${ano}`,
    });
    y = desenharIndicadores(doc, y, dados);

    doc.autoTable({
      startY: y,
      margin: { bottom: 20 },
      head: [['Hóspede', 'Check-in', 'Check-out', 'Noites', 'Valor', 'Comissão', 'Líquido', 'NF']],
      body: dados.reservas.map((r) => [
        r.hospede, fmtData(r.data_entrada), fmtData(r.data_saida), String(noitesEntre(r.data_entrada, r.data_saida)),
        fmtMoeda(r.valor_bruto), fmtMoeda(r.valor_comissao), fmtMoeda(r.valor_proprietario), r.numero_nf || '—',
      ]),
      styles: { fontSize: 8 },
      headStyles: { fillColor: [0, 74, 173] },
      didDrawPage: () => {},
    });
    y = doc.lastAutoTable.finalY + 8;

    if (dados.manutencoes.length) {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(10);
      doc.setTextColor(30, 41, 59);
      doc.text('Deduções do período', 14, y);
      y += 4;
      doc.autoTable({
        startY: y,
        margin: { bottom: 20 },
        head: [['Data', 'Serviço', 'Valor']],
        body: dados.manutencoes.map((m) => [fmtData(m.data), m.servico, fmtMoeda(m.valor)]),
        styles: { fontSize: 8 },
        headStyles: { fillColor: [180, 83, 9] },
      });
      y = doc.lastAutoTable.finalY + 8;
    }

    const observacoes = document.getElementById('rl-observacoes').value.trim();
    if (observacoes) {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(10);
      doc.setTextColor(30, 41, 59);
      doc.text('Observações', 14, y);
      y += 6;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(9);
      doc.setTextColor(71, 85, 105);
      doc.text(doc.splitTextToSize(observacoes, 182), 14, y);
    }

      desenharRodape(doc);
      abrirPreview(doc, `relatorio-${imovel.nome_referencia.replace(/\s+/g, '_')}-${mesInput}.pdf`, {
        imovelId, tipo: 'mensal', periodoTexto: `${NOMES_MES[mesIndice]}/${ano}`,
      });
  }

  async function gerarPdfAnual() {
    const imovelId = document.getElementById('rl-imovel').value;
    const ano = Number(document.getElementById('rl-ano').value);
    if (!imovelId || !ano) { await mostrarAlerta('Selecione o imóvel e o ano.', { titulo: 'Campos obrigatórios' }); return; }

    const { data: imovel, error: erroImovel } = await supabase
      .from('imoveis').select('nome_referencia, proprietarios!proprietario_id(nome)').eq('id', imovelId).single();
    if (erroImovel) { await mostrarAlerta('Erro: ' + erroImovel.message, { titulo: 'Erro' }); return; }

    let dadosPorMes;
    try {
      dadosPorMes = [];
      for (let m = 0; m < 12; m++) dadosPorMes.push(await dadosDoMes(imovelId, ano, m));
    } catch (err) {
      await mostrarAlerta('Erro ao montar o relatório: ' + err.message, { titulo: 'Erro' });
      return;
    }

    const totais = dadosPorMes.reduce((acc, d) => ({
      totalReservas: acc.totalReservas + d.totalReservas,
      totalDiarias: acc.totalDiarias + d.totalDiarias,
      valorBrutoTotal: acc.valorBrutoTotal + d.valorBrutoTotal, 
      totalLimpeza: acc.totalLimpeza + d.totalLimpeza,
      totalComissao: acc.totalComissao + d.totalComissao,
      totalDeducoes: acc.totalDeducoes + d.totalDeducoes,
      valorLiquidoRepassado: acc.valorLiquidoRepassado + d.valorLiquidoRepassado,
    }), { totalReservas: 0, totalDiarias: 0, valorBrutoTotal: 0, totalLimpeza: 0, totalComissao: 0, totalDeducoes: 0, valorLiquidoRepassado: 0 });
    totais.mediaDiaria = totais.totalDiarias > 0 ? (totais.valorBrutoTotal - totais.totalLimpeza) / totais.totalDiarias : 0;

    const doc = new jsPDF();
    let y = desenharCabecalho(doc, {
      subtitulo: 'Relatório Anual de Prestação de Contas',
      imovelNome: imovel.nome_referencia,
      proprietarioNome: imovel.proprietarios?.nome || '—',
      periodoTexto: `Ano de ${ano}`,
    });
    y = desenharIndicadores(doc, y, { ...totais, taxaOcupacao: null });

    doc.autoTable({
      startY: y,
      margin: { bottom: 20 },
      head: [['Mês', 'Reservas', 'Diárias', 'Bruto', 'Limpeza', 'Comissão', 'Deduções', 'Líquido']],
      body: dadosPorMes.map((d, i) => [
        NOMES_MES[i], String(d.totalReservas), String(d.totalDiarias), fmtMoeda(d.valorBrutoTotal),
        fmtMoeda(d.totalLimpeza), fmtMoeda(d.totalComissao), d.totalDeducoes ? '− ' + fmtMoeda(d.totalDeducoes) : '—', fmtMoeda(d.valorLiquidoRepassado),
      ]),
      foot: [['Total', String(totais.totalReservas), String(totais.totalDiarias), fmtMoeda(totais.valorBrutoTotal),
        fmtMoeda(totais.totalLimpeza), fmtMoeda(totais.totalComissao), totais.totalDeducoes ? '− ' + fmtMoeda(totais.totalDeducoes) : '—', fmtMoeda(totais.valorLiquidoRepassado)]],
      styles: { fontSize: 8 },
      headStyles: { fillColor: [0, 74, 173] },
      footStyles: { fillColor: [241, 245, 249], textColor: [30, 41, 59], fontStyle: 'bold' },
    });

    desenharRodape(doc);
    abrirPreview(doc, `relatorio-anual-${imovel.nome_referencia.replace(/\s+/g, '_')}-${ano}.pdf`, {
      imovelId, tipo: 'anual', periodoTexto: `Ano de ${ano}`,
    });
  }

  document.getElementById('btn-gerar-pdf').addEventListener('click', async () => {
    const tipo = document.querySelector('input[name="rl-tipo"]:checked').value;
    const btn = document.getElementById('btn-gerar-pdf');
    btn.disabled = true;
    btn.textContent = 'Gerando...';
    try {
      if (tipo === 'mensal') await gerarPdfMensal();
      else await gerarPdfAnual();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Visualizar Relatório';
    }
  });

  document.getElementById('rl-mes').value = new Date().toISOString().slice(0, 7);
  document.getElementById('rl-ano').value = new Date().getFullYear();
  await carregarImoveis();
</script>
</body>
